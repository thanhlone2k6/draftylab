{
  "name": "draftylab-v2",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/check-no-local-paths.mjs",
    "preview": "astro preview",
    "check": "astro check",
    "media:scan": "node scripts/scan-assets.mjs",
    "media:quality": "node scripts/encode-quality-test.mjs",
    "media:build": "node scripts/build-media.mjs",
    "test:media": "node --test scripts/build-media.test.mjs",
    "check:paths": "node scripts/check-no-local-paths.mjs",
    "test:e2e": "playwright test",
    "media:posters": "node scripts/posters-review.mjs",
    "build:deploy": "astro build && node scripts/prepare-dist.mjs && node scripts/check-no-local-paths.mjs",
    "test:unit": "node --import tsx --test tests/unit/*.test.ts",
    "check:functions": "tsc --noEmit -p functions",
    "dev:functions": "wrangler pages dev dist --port 8788",
    "media:upload": "node scripts/upload-media.mjs",
    "build:lead": "PUBLIC_LEAD_ENDPOINT=/api/lead astro build --outDir dist-lead && DIST_DIR=dist-lead R2_OUT_DIR=dist-lead-r2 node scripts/prepare-dist.mjs",
    "lead:local-r2": "node scripts/upload-media.mjs --dir dist-lead-r2 --execute --local",
    "build:cf": "PUBLIC_LEAD_ENDPOINT=/api/lead PUBLIC_TURNSTILE_SITEKEY=0x4AAAAAAFZKwOwfz57y22Nr npm run build:deploy",
    "build:preview": "PUBLIC_LEAD_ENDPOINT=/api/lead PUBLIC_TURNSTILE_SITEKEY=0x4AAAAAAFZKwOwfz57y22Nr npm run build:deploy",
    "deploy:preview": "npm run build:preview && wrangler pages deploy dist --project-name draftylab-v2 --branch preview --commit-dirty=true"
  },
  "dependencies": {
    "@astrojs/react": "^4.4.2",
    "@fontsource-variable/geist": "^5.3.0",
    "@hugeicons/core-free-icons": "^4.3.5",
    "@hugeicons/react": "^1.1.10",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^5.18.2",
    "gsap": "^3.15.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.3",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@cloudflare/workers-types": "^5.20261016.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "wrangler": "^4.151.1"
  }
}
