---
// Translated privacy policies: /en/privacy/ · /fr/privacy/ · /de/privacy/ · /nl/privacy/
import BaseLayout from '../../layouts/BaseLayout.astro';
import PrivacyPage from '../../components/sections/PrivacyPage.astro';
import { isLocale, type Locale } from '../../i18n/config';

export function getStaticPaths() {
  return ['en', 'fr', 'de', 'nl'].map((lang) => ({ params: { lang } }));
}

const locale = Astro.params.lang as Locale;
if (!isLocale(locale)) throw new Error(`unsupported locale: ${locale}`);
---
<BaseLayout locale={locale} page="privacy">
  <PrivacyPage locale={locale} />
</BaseLayout>
