---
// Community tab for /en/ · /fr/ · /de/ · /nl/. Labels are translated; post content stays as written.
import BaseLayout from '../../layouts/BaseLayout.astro';
import CommunityPage from '../../components/sections/CommunityPage.astro';
import { isLocale, OTHER_LOCALES, type Locale } from '../../i18n/config';

export function getStaticPaths() {
  return OTHER_LOCALES.map((lang) => ({ params: { lang } }));
}

const locale = Astro.params.lang as Locale;
if (!isLocale(locale)) throw new Error(`unsupported locale: ${locale}`);
---
<BaseLayout locale={locale} page="community">
  <CommunityPage locale={locale} />
</BaseLayout>
