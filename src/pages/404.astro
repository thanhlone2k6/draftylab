---
// Pages serves dist/404.html with a real 404 status (without it, Cloudflare Pages answers unknown paths with the
// home page and a 200 — e.g. a missing .mp4 would "succeed" with HTML). Vietnamese is the default locale.
import BaseLayout from '../layouts/BaseLayout.astro';
import NotFound from '../components/sections/NotFound.astro';
---
<BaseLayout locale="vi">
  <NotFound locale="vi" />
</BaseLayout>
