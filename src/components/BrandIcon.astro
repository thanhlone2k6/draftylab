---
// Real platform logos (owner, 2026-11-07 — "dùng lại 3 cái này, để nguyên viền của nó"): the Community
// page icon row uses the owner's own artwork, not redrawn glyphs. Facebook + TikTok are circles and
// Instagram is a rounded square, so the shape comes from the asset itself and is never clipped.
// Files live in `public/media/social/` (132px WebP, transparent, cut from the owner's originals).
export type BrandKey = 'facebook' | 'instagram' | 'tiktok';

interface Props { name: BrandKey }
const { name } = Astro.props;
const SRC: Record<BrandKey, string> = {
  facebook: '/media/social/facebook.webp',
  instagram: '/media/social/instagram.webp',
  tiktok: '/media/social/tiktok.webp',
};
---
<img class="brand-icon" src={SRC[name]} alt="" width="44" height="44" loading="lazy" decoding="async" />

<style>
  .brand-icon { display: block; width: 44px; height: 44px; pointer-events: none; }
</style>
