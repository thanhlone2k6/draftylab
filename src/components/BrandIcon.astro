---
// Platform logos for the Community page icon row.
//  • Facebook + Instagram: the owner's own files (2nd pass, "dùng lại 3 cái này, để nguyên viền của nó") —
//    shapes come from the assets (FB circle, IG rounded square), nothing is clipped or rounded by CSS.
//  • TikTok (3rd pass, owner: "tiktok để lại cái cũ đi cái này xấu quá"): back to the drawn mark — black
//    disc + the note with the cyan/red offset. The owner's AVIF version made the glyph too small at 44px.export type BrandKey = 'facebook' | 'instagram' | 'tiktok';

interface Props { name: BrandKey }
const { name } = Astro.props;
const uid = `brand-${name}-${Math.random().toString(36).slice(2, 8)}`;
---
{name === 'facebook' && (
  <img class="brand-icon" src="/media/social/facebook.webp" alt="" width="44" height="44" loading="lazy" decoding="async" />
)}
{name === 'instagram' && (
  <img class="brand-icon" src="/media/social/instagram.webp" alt="" width="44" height="44" loading="lazy" decoding="async" />
)}
{name === 'tiktok' && (
  <svg class="brand-icon" viewBox="0 0 24 24" role="presentation">
    <defs>
      <clipPath id={`${uid}-clip`}><circle cx="12" cy="12" r="12" /></clipPath>
    </defs>
    <circle cx="12" cy="12" r="12" fill="#000" />
    <circle cx="12" cy="12" r="11.4" fill="none" stroke="#2a2a2a" stroke-width="1.2" />
    <g clip-path={`url(#${uid}-clip)`}>
      <g transform="translate(12 12) scale(.62) translate(-12 -12)">
        <path transform="translate(-.34 .22)" fill="#25F4EE" d="M12.53.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z" />
        <path transform="translate(.34 -.22)" fill="#FE2C55" d="M12.53.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z" />
        <path fill="#fff" d="M12.53.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z" />
      </g>
    </g>
  </svg>
)}

<style>
  .brand-icon { display: block; width: 44px; height: 44px; pointer-events: none; }
</style>
