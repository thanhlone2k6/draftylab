---
// Full-colour platform badges (owner, 2026-11-07 — "dùng logo thật"): the Community page icon row
// shows the real brand marks, not a mono glyph. The footer keeps its own mono icons (PlatformIcon.astro).
// Everything is inline SVG: no icon font, no network, no CSP change.
export type BrandKey = 'facebook' | 'instagram' | 'tiktok';

interface Props { name: BrandKey }
const { name } = Astro.props;
// Unique ids so two badges on one page can never share a gradient/clip definition.
const uid = `brand-${name}-${Math.random().toString(36).slice(2, 8)}`;
---
{name === 'facebook' && (
  <svg viewBox="0 0 24 24" role="presentation">
    <circle cx="12" cy="12" r="12" fill="#1877F2" />
    <path fill="#fff" d="M16.15 15.45l.53-3.45h-3.31V9.76c0-.94.46-1.86 1.94-1.86h1.5V4.96s-1.36-.23-2.66-.23c-2.72 0-4.5 1.65-4.5 4.63V12H6.62v3.45h3.03v8.35a12.1 12.1 0 0 0 3.72 0v-8.35h2.78z" />
  </svg>
)}
{name === 'instagram' && (
  <svg viewBox="0 0 24 24" role="presentation">
    <defs>
      <radialGradient id={`${uid}-ring`} cx="0.3" cy="1.05" r="1.25">
        <stop offset="0" stop-color="#FEDA75" />
        <stop offset="0.32" stop-color="#FA7E1E" />
        <stop offset="0.62" stop-color="#D62976" />
        <stop offset="0.85" stop-color="#962FBF" />
        <stop offset="1" stop-color="#4F5BD5" />
      </radialGradient>
    </defs>
    <circle cx="12" cy="12" r="12" fill={`url(#${uid}-ring)`} />
    <g fill="none" stroke="#fff" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
      <rect x="6" y="6" width="12" height="12" rx="3.7" />
      <circle cx="12" cy="12" r="3" />
    </g>
    <circle cx="16.1" cy="7.9" r="0.85" fill="#fff" />
  </svg>
)}
{name === 'tiktok' && (
  <svg viewBox="0 0 24 24" role="presentation">
    <defs>
      <clipPath id={`${uid}-clip`}><circle cx="12" cy="12" r="12" /></clipPath>
    </defs>
    <circle cx="12" cy="12" r="12" fill="#000" />
    <circle cx="12" cy="12" r="11.4" fill="none" stroke="#2a2a2a" stroke-width="1.2" />
    <g clip-path={`url(#${uid}-clip)`}>
      <g transform="translate(12 12) scale(.82) translate(-12 -12)">
      <path transform="translate(-.5 .3)" fill="#25F4EE" d="M12.53.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z" />
      <path transform="translate(.5 -.3)" fill="#FE2C55" d="M12.53.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z" />
      <path fill="#fff" d="M12.53.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z" />
      </g>
    </g>
  </svg>
)}
