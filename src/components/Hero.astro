---
import { content, type Lang } from '../data/content';
import { r2 } from '../data/media';
interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = content[lang];
---
<section class="hero" id="top">
  <div class="shell hero-grid">
    <div class="hero-copy">
      <p class="eyebrow hero-eyebrow reveal">{t.hero.eyebrow}</p>
      <h1 class="display-hero hero-title reveal">
        <span class="hero-line">{t.hero.titleA}</span>
        <span class="hero-line hero-line-2">{t.hero.titleB}</span>
      </h1>
      <p class="lead hero-sub reveal">{t.hero.sub}</p>
      <div class="hero-cta reveal">
        <a href="#work" class="btn btn-primary">{t.hero.ctaPrimary}</a>
        <a href="#contact" class="btn btn-ghost">{t.hero.ctaSecondary}</a>
      </div>
    </div>

    <div class="hero-media reveal" data-hero-media>
      <div class="media-frame hero-frame">
        <video
          class="hero-video"
          poster="/media/hero/showreel-poster.jpg"
          muted
          loop
          autoplay
          playsinline
          webkit-playsinline
          disablepictureinpicture
          preload="auto"
          aria-label={t.hero.reelCaption}
        >
          <source src={r2('hero/showreel.mp4')} type="video/mp4" />
        </video>
        <div class="hero-video-controls" aria-label="Video controls">
          <button class="video-control" type="button" data-hero-play aria-label="Play or pause video">
            <svg class="icon-play" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5.5v13l10-6.5z" /></svg>
            <svg class="icon-pause" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 5h4v14H7zm6 0h4v14h-4z" /></svg>
          </button>
          <button class="video-control" type="button" data-hero-sound aria-label="Turn sound on or off" aria-pressed="false">
            <svg class="icon-muted" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 9v6h4l5 4V5L8 9zm12.5.2 3.3 3.3m0-3.3-3.3 3.3" /></svg>
            <svg class="icon-sound" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 9v6h4l5 4V5L8 9zm12 0c1.4 1.7 1.4 4.3 0 6m2.5-8.5c3 3 3 8 0 11" /></svg>
          </button>
        </div>
        <span class="hero-badge">{t.hero.reelCaption}</span>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    overflow: clip;
    padding-top: clamp(2.5rem, 6vw, 5rem);
    padding-bottom: clamp(3rem, 8vw, 6rem);
  }
  .hero-grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    align-items: center;
  }
  @media (min-width: 980px) {
    .hero-grid { grid-template-columns: 1.05fr 1fr; gap: clamp(2rem, 5vw, 5rem); }
  }

  .hero-eyebrow { margin-bottom: 1.4rem; }
  .hero-title { margin-bottom: 1.6rem; }
  .hero-line { display: block; }
  .hero-line-2 { color: var(--color-gold); }
  .hero-sub { max-width: 30ch; margin-bottom: 2.2rem; }
  .hero-cta { display: flex; flex-wrap: wrap; gap: 0.8rem; }

  .hero-media { order: -1; }
  @media (min-width: 980px) { .hero-media { order: 0; } }

  .hero-frame { aspect-ratio: 16 / 9; }
  .hero-video { width: 100%; height: 100%; object-fit: cover; }
  .hero-video-controls {
    position: absolute;
    right: 1rem;
    bottom: 1rem;
    z-index: 3;
    display: flex;
    gap: 0.45rem;
  }
  .video-control {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    color: white;
    background: rgb(13 13 13 / 0.32);
    border: 1px solid rgb(255 255 255 / 0.7);
    box-shadow: 0 4px 16px rgb(0 0 0 / 0.28), 0 1px 3px rgb(0 0 0 / 0.22);
    backdrop-filter: blur(8px);
  }
  .video-control svg { width: 17px; height: 17px; fill: currentColor; stroke: currentColor; stroke-width: 1.7; stroke-linecap: round; stroke-linejoin: round; }
  .icon-pause, .icon-sound { display: none; }
  [data-playing] .icon-play, [data-sound-on] .icon-muted { display: none; }
  [data-playing] .icon-pause, [data-sound-on] .icon-sound { display: block; }
  .hero-badge {
    position: absolute;
    left: 1rem;
    bottom: 1rem;
    z-index: 2;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-bone);
    background: color-mix(in srgb, var(--color-ink) 62%, transparent);
    backdrop-filter: blur(6px);
    padding: 0.4rem 0.75rem;
    border-radius: var(--radius-pill);
    border: 1px solid var(--color-line);
  }
</style>

<script>
  // Keep the hero reel playing whenever it is on screen and motion is allowed.
  const media = document.querySelector<HTMLElement>('[data-hero-media]');
  const vid = media?.querySelector<HTMLVideoElement>('video');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (vid && !reduce) {
    vid.volume = 0.6;
    // While the work lightbox is open, Work.astro unloads this video's src;
    // never (re)start fetching behind it.
    let lbOpen = false;
    document.addEventListener('drafty:lightbox', (e) => {
      lbOpen = Boolean((e as CustomEvent<{ open: boolean }>).detail.open);
    });
    const tryPlay = () => { if (!lbOpen) vid.play().catch(() => {}); };
    // Play as soon as enough data is ready, then keep it looping.
    vid.addEventListener('canplay', tryPlay, { once: true });
    if (vid.readyState >= 3) tryPlay();

    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver(
        ([entry]) => (entry.isIntersecting ? tryPlay() : vid.pause()),
        { threshold: 0.1 }
      );
      io.observe(vid);
    }
    // Resume on first user interaction if the browser blocked autoplay.
    const resume = () => { if (vid.paused) tryPlay(); };
    window.addEventListener('pointerdown', resume, { once: true });
    window.addEventListener('scroll', resume, { once: true, passive: true });
  }

  if (vid) {
    vid.playsInline = true;
    vid.setAttribute('playsinline', '');
    vid.setAttribute('webkit-playsinline', '');
    vid.disablePictureInPicture = true;
    const media = document.querySelector<HTMLElement>('[data-hero-media]');
    const playButton = media?.querySelector<HTMLButtonElement>('[data-hero-play]');
    const soundButton = media?.querySelector<HTMLButtonElement>('[data-hero-sound]');
    const syncState = () => media?.toggleAttribute('data-playing', !vid.paused);
    playButton?.addEventListener('click', () => {
      if (vid.paused) vid.play().catch(() => {}); else vid.pause();
      syncState();
    });
    soundButton?.addEventListener('click', () => {
      vid.muted = !vid.muted;
      media?.toggleAttribute('data-sound-on', !vid.muted);
      soundButton.setAttribute('aria-pressed', String(!vid.muted));
      if (vid.paused) vid.play().catch(() => {});
    });
    vid.addEventListener('play', syncState);
    vid.addEventListener('pause', syncState);
    media?.addEventListener('mouseenter', () => {
      vid.volume = 0.6;
      vid.muted = false;
      media.setAttribute('data-sound-on', '');
      soundButton?.setAttribute('aria-pressed', 'true');
      vid.play().catch(() => {
        vid.muted = true;
        media.removeAttribute('data-sound-on');
        soundButton?.setAttribute('aria-pressed', 'false');
      });
    });
    media?.addEventListener('mouseleave', () => {
      vid.muted = true;
      media.removeAttribute('data-sound-on');
      soundButton?.setAttribute('aria-pressed', 'false');
    });
  }
</script>
