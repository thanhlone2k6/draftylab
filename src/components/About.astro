---
import { content, type Lang } from '../data/content';
interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = content[lang];
---
<section class="section about" id="about">
  <div class="shell about-grid">
    <div class="about-media reveal">
      <div class="media-frame about-frame">
        <img src="/media/about/studio.jpg" alt="Drafty Lab" loading="lazy" width="1100" height="1400" />
      </div>
    </div>

    <div class="about-copy">
      <p class="eyebrow reveal">{t.about.eyebrow}</p>
      <h2 class="display-xl about-title reveal">{t.about.title}</h2>
      <div class="about-body reveal">
        <p>{t.about.p1}</p>
        <p>{t.about.p2}</p>
        <p class="about-philosophy">{t.about.p3}</p>
      </div>
      <div class="about-stats reveal">
        {t.about.stats.map((s) => (
          <div class="stat">
            <span class="stat-k">{s.k}</span>
            <span class="stat-v">{s.v}</span>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .about-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    align-items: center;
  }
  @media (min-width: 900px) {
    .about-grid { grid-template-columns: 0.85fr 1.15fr; gap: clamp(2rem, 6vw, 6rem); }
  }

  .about-frame { aspect-ratio: 4 / 5; }
  .about-frame img { width: 100%; height: 100%; }

  .about-title { margin: 0.8rem 0 1.6rem; }
  .about-body { display: flex; flex-direction: column; gap: 1.1rem; max-width: 46ch; }
  .about-body p { color: var(--color-mist); line-height: 1.7; text-wrap: pretty; }
  .about-philosophy { color: var(--color-bone) !important; border-left: 2px solid var(--color-gold); padding-left: 1.1rem; }

  .about-stats {
    display: flex;
    flex-wrap: wrap;
    gap: 2.5rem;
    margin-top: 2.5rem;
    padding-top: 2rem;
    border-top: 1px solid var(--color-line);
  }
  .stat { display: flex; flex-direction: column; gap: 0.25rem; }
  .stat-k { font-family: var(--font-display); font-size: clamp(1.8rem, 3.4vw, 2.6rem); color: var(--color-gold); line-height: 1; }
  .stat-v { font-size: 0.82rem; color: var(--color-mist); letter-spacing: 0.02em; }
</style>
