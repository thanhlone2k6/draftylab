---
// Shared platform marks (owner, 2026-11-07): the footer rows and the Community page icon row must show the
// same glyphs, so they live here once. Mono, `currentColor`, no icon font, no network.
export type PlatformKey = 'gmail' | 'instagram' | 'facebook' | 'tiktok';

interface Props { name: PlatformKey }
const { name } = Astro.props;
---
{name === 'gmail' && (
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
    <rect x="2.5" y="4.5" width="19" height="15" rx="2.5" />
    <path d="m3.5 7.5 8.5 6 8.5-6" />
  </svg>
)}
{name === 'instagram' && (
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
    <rect x="3" y="3" width="18" height="18" rx="5.2" />
    <circle cx="12" cy="12" r="4.1" />
    <circle cx="17.2" cy="6.8" r="1.15" fill="currentColor" stroke="none" />
  </svg>
)}
{name === 'facebook' && (
  <svg viewBox="0 0 24 24" fill="currentColor">
    <path d="M13.4 21.5v-7.6h2.6l.4-3h-3V8.9c0-.9.25-1.5 1.55-1.5h1.65V4.72c-.29-.04-1.27-.13-2.42-.13-2.4 0-4.03 1.46-4.03 4.14v2.17H7.5v3h2.25v7.6h3.65Z" />
  </svg>
)}
{name === 'tiktok' && (
  <svg viewBox="0 0 24 24" fill="currentColor">
    <path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z" />
  </svg>
)}
