---
import { content, type Lang } from '../data/content';
import { r2 } from '../data/media';
interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = content[lang];
---
<section class="section process" id="process">
  <div class="shell">
    <header class="sec-head reveal">
      <p class="eyebrow">{t.process.eyebrow}</p>
      <h2 class="display-xl">{t.process.title}</h2>
      <p class="lead sec-sub">{t.process.sub}</p>
    </header>

    <div class="process-media reveal" data-process-media>
      <div class="media-frame process-frame">
        <video
          class="process-video"
          src={r2('process/brief-to-poster.mp4')}
          poster="/media/process/brief-to-poster-poster.jpg"
          muted
          loop
          playsinline
          webkit-playsinline
          disablepictureinpicture
          preload="metadata"
          aria-label={t.process.caption}
        ></video>
        <button class="process-play" type="button" data-process-play aria-label={t.process.play}>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5.5v13l10-6.5z" /></svg>
        </button>
        <span class="process-badge">{t.process.caption}</span>
      </div>
    </div>
  </div>
</section>

<style>
  .sec-head { margin-bottom: clamp(2.5rem, 5vw, 4rem); max-width: 44rem; }
  .sec-head h2 { margin: 0.8rem 0 1rem; }
  .sec-sub { max-width: 42ch; }

  /* 16:9 motion ad — full shell width for a big, cinematic feel */
  .process-media { width: 100%; }
  .process-frame { aspect-ratio: 16 / 9; width: 100%; }
  .process-video { width: 100%; height: 100%; object-fit: contain; background: var(--color-ink); }

  .process-play {
    position: absolute;
    inset: 0;
    z-index: 3;
    display: grid;
    place-items: center;
    border: 0;
    background: transparent;
    cursor: pointer;
  }
  .process-play svg {
    width: clamp(64px, 9vw, 92px);
    height: clamp(64px, 9vw, 92px);
    padding: 22%;
    fill: var(--color-ink);
    background: var(--color-gold);
    border-radius: 50%;
    box-shadow: 0 8px 32px rgb(0 0 0 / 0.45);
    transition: transform 0.25s ease, opacity 0.25s ease;
  }
  .process-play:hover svg { transform: scale(1.07); }
  [data-playing] .process-play { opacity: 0; pointer-events: none; }

  .process-badge {
    position: absolute;
    left: 1rem;
    bottom: 1rem;
    z-index: 2;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-bone);
    background: color-mix(in srgb, var(--color-ink) 62%, transparent);
    backdrop-filter: blur(6px);
    padding: 0.4rem 0.75rem;
    border-radius: var(--radius-pill);
    border: 1px solid var(--color-line);
  }
  [data-playing] .process-badge { display: none; }
</style>

<script>
  // Autoplay the motion ad while it is on screen; click to play/pause.
  const root = document.querySelector<HTMLElement>('[data-process-media]');
  const vid = root?.querySelector<HTMLVideoElement>('video');
  const btn = root?.querySelector<HTMLButtonElement>('[data-process-play]');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (vid) {
    vid.playsInline = true;
    vid.setAttribute('playsinline', '');
    vid.setAttribute('webkit-playsinline', '');
    vid.disablePictureInPicture = true;
  }

  if (vid && root && !reduce) {
    // Work.astro unloads every non-lightbox video while the lightbox is open;
    // don't refetch behind it.
    let lbOpen = false;
    document.addEventListener('drafty:lightbox', (e) => {
      lbOpen = Boolean((e as CustomEvent<{ open: boolean }>).detail.open);
    });
    const tryPlay = () => { if (!lbOpen) vid.play().then(() => root.setAttribute('data-playing', '')).catch(() => {}); };
    const pause = () => { vid.pause(); root.removeAttribute('data-playing'); };

    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver(
        ([entry]) => (entry.isIntersecting ? tryPlay() : pause()),
        { threshold: 0.35 }
      );
      io.observe(vid);
    } else {
      tryPlay();
    }

    btn?.addEventListener('click', () => { if (vid.paused) tryPlay(); else pause(); });
    vid.addEventListener('play', () => root.setAttribute('data-playing', ''));
    vid.addEventListener('pause', () => root.removeAttribute('data-playing'));
  } else {
    // Reduced motion or no JS support: keep the manual play control working.
    btn?.addEventListener('click', async () => {
      if (!vid) return;
      if (vid.paused) await vid.play().catch(() => {}); else vid.pause();
    });
  }
</script>
