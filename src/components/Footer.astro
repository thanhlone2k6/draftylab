---
import { content, CONTACT_EMAIL, SOCIAL, type Lang } from '../data/content';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = content[lang];
const nav = [
  { href: '#work', label: t.nav.work },
  { href: '#capabilities', label: t.nav.capabilities },
  { href: '#approach', label: t.nav.approach },
  { href: '#about', label: t.nav.about },
];
---
<footer class="site-footer">
  <div class="shell">
    <div class="footer-top">
      <div class="footer-brand">
        <img src="/media/logo.png" alt="Drafty Lab" width="150" height="38" />
        <p class="footer-tagline">{t.footer.tagline}</p>
      </div>
      <div class="footer-cols">
        <div>
          <p class="footer-h">{t.footer.nav}</p>
          {nav.map((i) => <a href={i.href} class="footer-link link-underline">{i.label}</a>)}
        </div>
        <div>
          <p class="footer-h">{t.footer.social}</p>
          <a href={SOCIAL.instagram} target="_blank" rel="noopener" class="footer-link link-underline">Instagram</a>
          <a href={SOCIAL.facebook} target="_blank" rel="noopener" class="footer-link link-underline">Facebook</a>
        </div>
        <div>
          <p class="footer-h">{t.footer.contact}</p>
          <a href={`mailto:${CONTACT_EMAIL}`} class="footer-link link-underline">{CONTACT_EMAIL}</a>
        </div>
      </div>
    </div>
    <div class="footer-bottom">
      <span>© <span data-year>2026</span> Drafty Lab. {t.footer.rights}</span>
      <span class="footer-place">Hà Nội, Việt Nam</span>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--color-line-soft);
    padding-block: clamp(3rem, 6vw, 5rem) 2rem;
  }
  .footer-top {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    padding-bottom: 3rem;
  }
  @media (min-width: 800px) {
    .footer-top { grid-template-columns: 1.2fr 2fr; }
  }
  .footer-brand img { height: 30px; width: auto; margin-bottom: 1rem; }
  .footer-tagline { color: var(--color-gold); font-size: 0.95rem; letter-spacing: 0.02em; }
  .footer-cols {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2rem;
  }
  @media (min-width: 560px) { .footer-cols { grid-template-columns: repeat(3, 1fr); } }
  .footer-h {
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: var(--color-mist);
    margin-bottom: 1rem;
  }
  .footer-link {
    display: block;
    font-size: 0.95rem;
    color: var(--color-bone);
    padding: 0.28rem 0;
    width: fit-content;
    transition: color var(--dur-fast) var(--ease-out-soft);
  }
  .footer-link:hover { color: var(--color-gold); }
  .footer-bottom {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.5rem;
    justify-content: space-between;
    padding-top: 2rem;
    border-top: 1px solid var(--color-line-soft);
    font-size: 0.85rem;
    color: var(--color-mist);
  }
</style>
