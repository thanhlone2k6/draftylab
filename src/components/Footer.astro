---
import { contact, footer, site } from '../data/content';
const year = new Date().getFullYear();
---
<footer class="ftr">
  <div class="container-x ftr__inner">
    <div>
      <img src="/media/v1-temp/logo.webp" alt={site.name} width="320" height="81" class="ftr__logo" loading="lazy" />
      <p class="ftr__line">{footer.line}</p>
    </div>
    <ul class="ftr__links">
      <li><a href={`mailto:${contact.email}`}>{contact.email}</a></li>
      <li><a href={contact.instagram} target="_blank" rel="noopener noreferrer">Instagram</a></li>
      <li><a href={contact.facebook} target="_blank" rel="noopener noreferrer">Facebook</a></li>
    </ul>
  </div>
  <div class="container-x ftr__base">
    <span>© {year} {site.name}</span>
    <span>{footer.note}</span>
  </div>
</footer>
<style>
  .ftr { padding-block: 24px 28px; }
  .ftr__inner { display: flex; justify-content: space-between; gap: 32px; flex-wrap: wrap; }
  .ftr__logo { height: 24px; width: auto; }
  .ftr__line { margin: 12px 0 0; color: var(--c-fg-muted); }
  .ftr__links { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 4px; }
  .ftr__links a { display: inline-flex; align-items: center; min-height: 40px; color: var(--c-fg); text-decoration: none; }
  .ftr__links a:hover { text-decoration: underline; text-underline-offset: 5px; }
  .ftr__base { display: flex; justify-content: space-between; gap: 16px; flex-wrap: wrap; margin-top: 32px; color: var(--c-fg-faint); font-size: 0.85rem; }
</style>
