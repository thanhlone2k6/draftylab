---
import { content, type Lang } from '../data/content';
import { featuredProjects, carouselProjects, projects } from '../data/projects';
interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = content[lang];
const loop = [...carouselProjects, ...carouselProjects];
---
<section class="section" id="work">
  <div class="shell">
    <header class="sec-head reveal">
      <p class="eyebrow">{t.work.eyebrow}</p>
      <h2 class="display-xl">{t.work.title}</h2>
      <p class="lead sec-sub">{t.work.sub}</p>
    </header>

    <div class="featured-grid">
      {featuredProjects.map((p) => (
        <article
          class="work-card work-card--featured reveal"
          data-preview
          data-project={p.id}
          tabindex="0"
          aria-label={`${p.title[lang]} — ${t.work.expandLabel}`}
        >
          <div class="media-frame work-frame" style={`aspect-ratio:${p.aspect}`}>
            <img src={p.poster} alt={p.title[lang]} loading="lazy" decoding="async" width="900" height="1200" />
            {p.preview && (
              <video class="work-preview" muted loop playsinline webkit-playsinline disablepictureinpicture preload="none" poster={p.poster} data-full={p.preview} data-small={p.preview480 || p.previewMobile || p.preview}>
                <source src={p.preview480 || p.previewMobile || p.preview} type="video/mp4" />
              </video>
            )}
            <span class="work-tag">{t.work.tags[p.tag]}</span>
          </div>
          <div class="work-info">
            <h3 class="work-title">{p.title[lang]}</h3>
            <p class="work-meta">{p.meta[lang]} · {p.year}</p>
          </div>
        </article>
      ))}
    </div>
  </div>

  {carouselProjects.length > 0 && (
    <div class="work-rail" data-rail aria-label={t.work.moreLabel}>
      <div class="work-rail-track" data-rail-track>
        {loop.map((p, i) => (
          <article
            class="rail-card"
            data-preview
            data-project={p.id}
            tabindex="0"
            aria-label={`${p.title[lang]} — ${t.work.expandLabel}`}
            aria-hidden={i >= carouselProjects.length ? 'true' : undefined}
          >
            <div class="media-frame rail-frame" style={`aspect-ratio:${p.aspect}`}>
              <img src={p.poster} alt={p.title[lang]} loading="lazy" decoding="async" />
              {p.preview && (
                <video class="rail-preview" muted loop playsinline webkit-playsinline disablepictureinpicture preload="none" poster={p.poster} data-small={p.preview480 || p.previewMobile || p.preview}>
                  <source src={p.preview480 || p.previewMobile || p.preview} type="video/mp4" />
                </video>
              )}
              <span class="rail-tag">{t.work.tags[p.tag]}</span>
            </div>
            <div class="rail-info">
              <h3 class="rail-title">{p.title[lang]}</h3>
              <p class="rail-meta">{p.meta[lang]} · {p.year}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  )}
  <script type="application/json" data-projects-json set:html={JSON.stringify(projects)} />

  <div class="lightbox" data-lightbox hidden>
    <div class="lightbox-backdrop" data-lightbox-close></div>
    <div class="lightbox-panel" role="dialog" aria-modal="true" aria-labelledby="lightbox-title">
      <button class="lightbox-close" type="button" data-lightbox-close aria-label={t.nav.close}>×</button>
      <div class="media-frame lightbox-frame">
        <video class="lightbox-video" data-lightbox-video playsinline webkit-playsinline disablepictureinpicture preload="metadata"></video>
      </div>
      <div class="lightbox-foot">
        <div class="lightbox-bar">
          <button class="lightbox-btn" type="button" data-lightbox-play aria-label={t.work.playHint}>
            <svg class="icon-play" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5.5v13l10-6.5z" /></svg>
            <svg class="icon-pause" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 5h4v14H7zm6 0h4v14h-4z" /></svg>
          </button>
          <input class="lightbox-seek" type="range" min="0" max="1000" value="0" step="1" data-lightbox-seek aria-label={t.work.seekLabel} />
          <span class="lightbox-time" data-lightbox-time>0:00 / 0:00</span>
          <button class="lightbox-btn" type="button" data-lightbox-sound aria-label={t.work.playHint}>
            <svg class="icon-muted" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 9v6h4l5 4V5L8 9zm12.5.2 3.3 3.3m0-3.3-3.3 3.3" /></svg>
            <svg class="icon-sound" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 9v6h4l5 4V5L8 9zm12 0c1.4 1.7 1.4 4.3 0 6m2.5-8.5c3 3 3 8 0 11" /></svg>
          </button>
        </div>
        <div class="lightbox-meta">
          <h3 class="lightbox-title" id="lightbox-title" data-lightbox-title></h3>
          <p class="lightbox-sub" data-lightbox-sub></p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .sec-head { margin-bottom: clamp(2.5rem, 5vw, 4rem); max-width: 46rem; }
  .sec-head h2 { margin: 0.8rem 0 1rem; }
  .sec-sub { max-width: 44ch; }
  /* Trim the global section padding at the bottom so the gap to Capabilities
     lands ~64-96px desktop / ~40-64px mobile instead of 2x 11rem. */
  #work { padding-bottom: clamp(0.75rem, 1.5vw, 1.25rem); }

  /* ---- Featured row ---- */
  .featured-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.1rem;
  }
  @media (min-width: 720px) { .featured-grid { grid-template-columns: repeat(4, 1fr); } }

  .work-frame { width: 100%; }
  .work-frame img { width: 100%; height: 100%; }

  .work-preview {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 1;
  }
  .work-card:hover .media-frame img { transform: scale(1.04); }

  .work-tag,
  .rail-tag {
    position: absolute;
    top: 0.85rem;
    left: 0.85rem;
    z-index: 4;
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-bone);
    background: color-mix(in srgb, var(--color-ink) 60%, transparent);
    backdrop-filter: blur(6px);
    border: 1px solid var(--color-line);
    padding: 0.32rem 0.65rem;
    border-radius: var(--radius-pill);
  }

  .work-info { padding: 0.9rem 0.15rem 0; }
  .work-title { font-family: var(--font-display); font-size: 1.3rem; line-height: 1.15; }
  .work-meta { font-size: 0.86rem; color: var(--color-mist); margin-top: 0.3rem; }

  /* ---- Horizontal rail (JS marquee + free drag, see script) ---- */
  .work-rail {
    margin-top: clamp(2.5rem, 5vw, 4rem);
    overflow: hidden;
    cursor: grab;
    touch-action: pan-y;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 4%, #000 96%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 4%, #000 96%, transparent);
  }
  .work-rail.is-dragging { cursor: grabbing; }
  .work-rail-track {
    display: flex;
    gap: 1.1rem;
    width: max-content;
    padding-inline: clamp(1.25rem, 4vw, 3.5rem);
    will-change: transform;
  }
  .rail-card { cursor: pointer; }
  .work-card--featured { cursor: pointer; }

  .rail-card {
    flex: none;
    width: clamp(210px, 24vw, 300px);
  }
  .rail-frame { width: 100%; }
  .rail-frame img { width: 100%; height: 100%; }

  .rail-preview {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 1;
  }
  .rail-card:hover .rail-frame img { transform: scale(1.04); }

  /* clicking the card pins the clip playing in place */
  .rail-card[data-playing] .rail-preview { opacity: 1; }
  .rail-card[data-playing] .rail-frame img { transform: scale(1.04); }

  .rail-info { padding: 0.8rem 0.1rem 0; }
  .rail-title { font-family: var(--font-display); font-size: 1.15rem; line-height: 1.15; }
  .rail-meta { font-size: 0.82rem; color: var(--color-mist); margin-top: 0.25rem; }

  @keyframes rail-scroll {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }

  /* ---- Lightbox (rail card expanded view) ---- */
  .lightbox[hidden] { display: none; }
  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 200;
    display: grid;
    place-items: center;
    padding: clamp(1rem, 4vw, 2.5rem);
  }
  .lightbox-backdrop {
    position: absolute;
    inset: 0;
    background: rgb(8 8 8 / 0.82);
    backdrop-filter: blur(10px);
  }
  /* Panel width comes from the video's real aspect ratio (--lb-ar, set by JS)
     minus the space the controls + title need (--lb-chrome), so the panel is
     always exactly as wide as its video: no black filler, nothing cropped,
     and it never overflows any viewport. */
  .lightbox-panel {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    width: min(var(--lb-w, 960px), calc((100dvh - var(--lb-chrome, 8rem)) * var(--lb-ar, 1.777)), calc(100vw - 2rem));
    max-height: 100%;
    background: var(--color-charcoal, #171715);
    border: 1px solid var(--color-line);
    border-radius: 1rem;
    overflow: hidden;
    box-shadow: 0 24px 80px rgb(0 0 0 / 0.6);
  }
  .lightbox-frame {
    flex: 0 1 auto;
    min-height: 0;
    width: 100%;
    aspect-ratio: var(--lb-ar, 1.777);
    background: #000;
  }
  .lightbox-video { width: 100%; height: 100%; object-fit: contain; background: #000; }
  .lightbox-close {
    position: absolute;
    top: 0.7rem;
    right: 0.7rem;
    z-index: 4;
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    color: white;
    font-size: 1.3rem;
    line-height: 1;
    background: rgb(13 13 13 / 0.55);
    border: 1px solid rgb(255 255 255 / 0.7);
    cursor: pointer;
  }
  /* Control bar always sits below the frame (never overlaps the video). */
  .lightbox-bar {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    padding: 0.7rem 0.9rem;
    background: var(--color-charcoal, #171715);
  }
  .lightbox-btn {
    display: grid;
    place-items: center;
    flex: none;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    color: white;
    background: transparent;
    border: 1px solid var(--color-line);
    cursor: pointer;
  }
  .lightbox-btn svg { width: 16px; height: 16px; fill: currentColor; }
  .lightbox-btn .icon-pause { display: none; }
  [data-lb-playing] .lightbox-btn .icon-play { display: none; }
  [data-lb-playing] .lightbox-btn .icon-pause { display: block; }
  .lightbox-btn .icon-sound { display: none; }
  [data-lb-sound] .lightbox-btn .icon-muted { display: none; }
  [data-lb-sound] .lightbox-btn .icon-sound { display: block; }
  .lightbox-seek {
    flex: 1;
    accent-color: var(--color-gold);
    cursor: pointer;
  }
  .lightbox-time {
    flex: none;
    font-size: 0.8rem;
    font-variant-numeric: tabular-nums;
    color: var(--color-mist);
  }
  .lightbox-meta { padding: 0 1rem 1rem; }
  .lightbox-title { font-family: var(--font-display); font-size: 1.25rem; line-height: 1.2; }
  .lightbox-sub { font-size: 0.85rem; color: var(--color-mist); margin-top: 0.2rem; }
  @media (min-width: 721px) {
    /* Desktop: meta as a compact row beside the bar, saves vertical space for tall videos. */
    .lightbox-foot { display: flex; align-items: center; gap: 1rem; padding: 0 0.9rem 0.9rem; }
    .lightbox-foot .lightbox-bar { flex: 1; padding: 0; background: transparent; }
    .lightbox-foot .lightbox-meta { padding: 0; min-width: 0; }
    .lightbox-foot .lightbox-title { font-size: 1.05rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .lightbox-foot .lightbox-sub { display: none; }
    /* Chrome = panel border + foot row + lightbox padding ≈ 8rem */
    .lightbox-panel { --lb-chrome: 8rem; }
  }

  @media (max-width: 600px) {
    .lightbox {
      padding: max(0.5rem, env(safe-area-inset-top)) max(0.5rem, env(safe-area-inset-right)) max(0.5rem, env(safe-area-inset-bottom)) max(0.5rem, env(safe-area-inset-left));
    }
    .lightbox-panel {
      border-radius: 0.8rem;
    }
    /* Chrome = safe paddings + bar + two-line meta ≈ 10.5rem */
    .lightbox-panel { --lb-chrome: 10.5rem; }
    .lightbox-bar {
      gap: 0.45rem;
      padding: 0.6rem 0.7rem;
    }
    .lightbox-btn {
      width: 34px;
      height: 34px;
    }
    .lightbox-time {
      font-size: 0.7rem;
    }
    .lightbox-meta {
      padding: 0 0.75rem 0.75rem;
    }
    .lightbox-title {
      font-size: 1.05rem;
    }
    .lightbox-sub {
      font-size: 0.78rem;
    }
    .lightbox-close {
      top: 0.55rem;
      right: 0.55rem;
      width: 38px;
      height: 38px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .work-rail-track { animation: none; }
  }
</style>

<script>
  // Featured cards: always previewing (muted autoplay on load).
  // Desktop (hover): entering a card unmutes THAT card, leaving re-mutes.
  // Touch (mobile): scrolling a card into view auto-plays it WITH sound;
  // scrolling away pauses + mutes. Unmuting an already-playing video needs
  // no user gesture — only starting playback with sound does — so hover /
  // scroll unmute works without a prior click.
  // Rail cards keep the old hover-to-preview behaviour (too many clips to autoplay).
  const hoverOK = window.matchMedia('(hover: hover)').matches;
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Lightbox refs hoisted to the top so every media handler can guard on it.
  const lb = document.querySelector<HTMLElement>('[data-lightbox]');
  const lbVideo = lb?.querySelector<HTMLVideoElement>('[data-lightbox-video]');
  const lbOpen = () => !!lb && !lb.hidden;

  // ---- Exclusive media loading ------------------------------------------
  // While the lightbox is open every other video on the page must stop
  // fetching: pause alone is not enough, the src has to be detached and
  // load() called AFTER the sources are removed (calling load() while a src
  // is attached would simply start a fresh request).
  interface MediaState {
    directSrc: string;
    childSrcs: string[];
    preload: string;
    wasPlaying: boolean;
  }
  // First-detach snapshot per video; surviving quick re-opens means a video
  // whose restore is still pending can never be re-saved as "empty".
  const mediaState = new WeakMap<HTMLVideoElement, MediaState>();
  const detachedMedia = new Set<HTMLVideoElement>();
  // Card videos start fetching only once they approach the viewport.
  // Tracked so a lightbox close can revive them without waiting for a new intersection.
  const lazyPlay = new WeakSet<HTMLVideoElement>();
  const autoplayWhenVisible = (vid: HTMLVideoElement, start: () => void) => {
    if (reduceMotion) return;
    if (!('IntersectionObserver' in window)) { start(); return; }
    lazyPlay.add(vid);
    new IntersectionObserver(([entry]) => {
      if (lbOpen() || detachedMedia.has(vid)) return;
      if (entry.isIntersecting) start(); else vid.pause();
    }, { rootMargin: '200px 200px 200px 200px' }).observe(vid);
  };

  const detachVideo = (v: HTMLVideoElement) => {
    [...v.querySelectorAll('source')].forEach((s) => s.removeAttribute('src'));
    if (v.getAttribute('src')) v.removeAttribute('src');
    v.muted = true;
    v.pause();
    v.preload = 'none';
    v.load(); // detach resource selection — nothing left to fetch
  };

  const unloadBackgroundMedia = () => {
    document.querySelectorAll<HTMLVideoElement>('video').forEach((v) => {
      if (v === lbVideo || detachedMedia.has(v)) return; // already unloaded
      if (!mediaState.has(v)) {
        mediaState.set(v, {
          directSrc: v.getAttribute('src') || '',
          childSrcs: [...v.querySelectorAll('source')].map((s) => s.getAttribute('src') || ''),
          preload: v.getAttribute('preload') || '',
          wasPlaying: !v.paused,
        });
      }
      detachVideo(v);
      detachedMedia.add(v);
    });
  };

  // One shared observer revives videos that were outside the viewport when
  // the lightbox closed (their component has no IO of their own).
  const resumeIO = 'IntersectionObserver' in window
    ? new IntersectionObserver((entries) => {
        entries.forEach((e) => {
          if (!e.isIntersecting) return;
          if (lbOpen()) return; // keep watching — never fetch behind an open lightbox
          resumeIO.unobserve(e.target);
          restoreVideo(e.target as HTMLVideoElement, true);
        });
      }, { threshold: 0.25 })
    : null;

  const restoreVideo = (v: HTMLVideoElement, autoplay: boolean) => {
    detachedMedia.delete(v);
    const st = mediaState.get(v);
    if (st) {
      if (st.directSrc) v.setAttribute('src', st.directSrc);
      const kids = [...v.querySelectorAll('source')];
      st.childSrcs.forEach((src, i) => { if (src && kids[i]) kids[i].setAttribute('src', src); });
      v.preload = st.preload || 'metadata';
    }
    v.load(); // re-select from the restored sources
    if (autoplay && (st?.wasPlaying || lazyPlay.has(v)) && !reduceMotion) {
      v.muted = true;
      v.play().catch(() => {});
    }
  };

  const restoreBackgroundMedia = () => {
    [...detachedMedia].forEach((v) => {
      const r = v.getBoundingClientRect();
      // Both axes: the marquee's duplicated half sits off-screen horizontally
      // and must not refetch just because its row is vertically visible.
      const inView = r.bottom > 0 && r.top < window.innerHeight && r.right > 0 && r.left < window.innerWidth;
      if (inView || !resumeIO) restoreVideo(v, true);
      else resumeIO.observe(v); // zero network until the card actually scrolls back
    });
  };

  // ---- Featured desktop quality policy ----------------------------------
  // Cards ship 480p30. Only with hard evidence of a fast connection
  // (Network Information API reporting 4g, decent downlink, no Save-Data)
  // do the featured cards upgrade to their 720p source — once, before the
  // first play, so there is no mid-session reload. No API => stay 480p.
  const conn = (navigator as unknown as { connection?: { saveData?: boolean; effectiveType?: string; downlink?: number } }).connection;
  // Desktop pointer devices only — mobile policy is "always 480p".
  const goodNet = hoverOK && !!conn && conn.saveData !== true && conn.effectiveType === '4g' && (conn.downlink ?? 0) >= 4;
  const upgradeFeaturedSource = (vid: HTMLVideoElement) => {
    if (!goodNet) return;
    const full = vid.dataset.full;
    if (!full) return;
    const src = vid.querySelector('source');
    if (src && src.getAttribute('src') !== full) {
      src.setAttribute('src', full);
      vid.load();
    }
  };

  const featured = [...document.querySelectorAll<HTMLElement>('.featured-grid [data-preview]')];
  const setSound = (card: HTMLElement, vid: HTMLVideoElement, on: boolean) => {
    vid.muted = !on;
    card.toggleAttribute('data-sound-on', on);
    card.querySelector('[data-video-sound]')?.setAttribute('aria-pressed', String(on));
  };
  const muteOthers = (except: HTMLElement) => featured.forEach((c) => {
    if (c === except) return;
    const v = c.querySelector<HTMLVideoElement>('video');
    if (v && !v.muted) setSound(c, v, false);
  });
  const playWithSound = (card: HTMLElement, vid: HTMLVideoElement) => {
    muteOthers(card);
    if (vid.paused) {
      vid.muted = true;
      vid.play().then(() => setSound(card, vid, true)).catch(() => {});
    } else {
      setSound(card, vid, true);
    }
  };

  featured.forEach((card) => {
    const vid = card.querySelector<HTMLVideoElement>('video');
    if (!vid) return;
    vid.volume = 0.8;
    vid.addEventListener('play', () => card.setAttribute('data-playing', ''));
    vid.addEventListener('pause', () => card.removeAttribute('data-playing'));

    let firstStart = true;
    autoplayWhenVisible(vid, () => {
      if (firstStart) {
        firstStart = false;
        upgradeFeaturedSource(vid);
        vid.muted = true;
      }
      if (vid.paused) vid.play().catch(() => {});
    });

    if (hoverOK) {
      card.addEventListener('mouseenter', () => { if (!reduceMotion && !lbOpen()) playWithSound(card, vid); });
      card.addEventListener('mouseleave', () => setSound(card, vid, false));
      card.addEventListener('focusin', () => { if (!reduceMotion && !lbOpen()) playWithSound(card, vid); });
      card.addEventListener('focusout', (event) => {
        if (!card.contains(event.relatedTarget as Node)) setSound(card, vid, false);
      });
    } else if ('IntersectionObserver' in window && !reduceMotion) {
      // Never pause: the featured clips loop forever. Leaving the viewport
      // only mutes (no background audio); re-entering unmutes that card.
      new IntersectionObserver(([entry]) => {
        if (lbOpen()) return; // never touch media behind the lightbox
        if (entry.isIntersecting) playWithSound(card, vid);
        else setSound(card, vid, false);
      }, { threshold: 0.5 }).observe(card);
    }

    // Click (or Enter/Space) opens the expanded lightbox view.
    card.addEventListener('click', () => {
      openLightbox(card.getAttribute('data-project') || '');
    });
    card.addEventListener('keydown', (event) => {
      if (event.key === 'Enter' || event.key === ' ') {
        event.preventDefault();
        openLightbox(card.getAttribute('data-project') || '');
      }
    });
  });

  // Rail cards: all clips autoplay muted; hover/focus enables sound for that clip.
  document.querySelectorAll<HTMLElement>('[data-rail] [data-preview]').forEach((card) => {
    const vid = card.querySelector<HTMLVideoElement>('video');
    if (!vid) return;
    vid.volume = 0.6;

    const play = () => {
      if (lbOpen()) return; // never fetch behind the lightbox
      // Start on the same frame used by the poster so the card does not visibly jump.
      if (vid.currentTime < 0.05) vid.currentTime = 0.5;
      vid.muted = true;
      vid.play().then(() => card.setAttribute('data-playing', '')).catch(() => {});
    };
    const soundOn = () => {
      if (lbOpen()) return;
      vid.muted = false;
      card.setAttribute('data-sound-on', '');
    };
    const soundOff = () => {
      vid.muted = true;
      card.removeAttribute('data-sound-on');
    };

    // Fetch + play only while the card is near the viewport (one clip per visible card).
    autoplayWhenVisible(vid, play);
    // Retry after the first-load cover is removed in case autoplay lost an early race.
    document.addEventListener('drafty:ready', () => {
      if (vid.paused && lazyPlay.has(vid)) {
        const r = vid.getBoundingClientRect();
        if (r.bottom > 0 && r.top < window.innerHeight && r.right > 0 && r.left < window.innerWidth) play();
      }
    }, { once: true });

    card.addEventListener('mouseenter', () => soundOn());
    card.addEventListener('mouseleave', () => soundOff());
    card.addEventListener('focusin', () => soundOn());
    card.addEventListener('focusout', (event) => {
      if (!card.contains(event.relatedTarget as Node)) soundOff();
    });

    // Click (not drag) opens the expanded lightbox view.
    card.addEventListener('click', (event) => {
      if (suppressClick) return;
      openLightbox(card.getAttribute('data-project') || '');
    });
    card.addEventListener('keydown', (event) => {
      if (event.key === 'Enter' || event.key === ' ') {
        event.preventDefault();
        openLightbox(card.getAttribute('data-project') || '');
      }
    });
  });

  // ---- Rail free-scroll marquee (auto-drift + pointer drag) ----
  const rail = document.querySelector<HTMLElement>('[data-rail]');
  const railTrack = rail?.querySelector<HTMLElement>('[data-rail-track]');
  let suppressClick = false;
  if (rail && railTrack && !reduceMotion) {
    let offset = 0;
    let half = 1;
    let dragging = false;
    let resumeAt = 0;
    const measure = () => {
      const style = getComputedStyle(railTrack);
      const pad = parseFloat(style.paddingLeft) + parseFloat(style.paddingRight);
      half = Math.max(1, (railTrack.scrollWidth - pad) / 2);
    };
    measure();
    window.addEventListener('resize', measure);
    const SPEED = 40; // px per second
    let last = performance.now();
    const tick = (now: number) => {
      const dt = Math.min(0.1, (now - last) / 1000);
      last = now;
      const idle = !dragging && now >= resumeAt
        && document.visibilityState === 'visible'
        && !lbOpen(); // marquee rests while the lightbox is open
      if (idle) {
        offset -= SPEED * dt;
        if (offset <= -half) offset += half;
        railTrack.style.transform = `translateX(${offset}px)`;
      }
      requestAnimationFrame(tick);
    };
    requestAnimationFrame(tick);

    let startX = 0;
    let startOffset = 0;
    let moved = 0;
    // NOTE: no setPointerCapture on the rail — with capture active the
    // browser retargets the click event to the capture element, so card
    // click listeners never fire (this was the "lightbox won't open on
    // desktop rail" bug). Drag tracking uses window listeners instead.
    rail.addEventListener('pointerdown', (event) => {
      if ((event.target as HTMLElement).closest('button, input, a')) return;
      dragging = true;
      moved = 0;
      suppressClick = false;
      startX = event.clientX;
      startOffset = offset;
      rail.classList.add('is-dragging');
      // Pin the track for the whole press: if the marquee kept drifting
      // between mousedown and mouseup, the browser would see different
      // targets and retarget the click to <html> — the card's click
      // listener would never run (this was the desktop rail bug).
      railTrack.style.transform = `translateX(${offset}px)`;
    });
    const onDragMove = (event: PointerEvent) => {
      if (!dragging) return;
      const dx = event.clientX - startX;
      moved = Math.max(moved, Math.abs(dx));
      offset = startOffset + dx;
      offset = ((offset % half) + half) % half;
      if (offset > 0) offset -= half;
      railTrack.style.transform = `translateX(${offset}px)`;
    };
    const endDrag = () => {
      if (!dragging) return;
      dragging = false;
      suppressClick = moved > 8;
      resumeAt = performance.now() + 2500;
      rail.classList.remove('is-dragging');
    };
    window.addEventListener('pointermove', onDragMove);
    window.addEventListener('pointerup', endDrag);
    window.addEventListener('pointercancel', endDrag);
  }

  // ---- Lightbox: expanded rail video with seek ----
  const lbPlay = lb?.querySelector<HTMLButtonElement>('[data-lightbox-play]');
  const lbSeek = lb?.querySelector<HTMLInputElement>('[data-lightbox-seek]');
  const lbTime = lb?.querySelector<HTMLElement>('[data-lightbox-time]');
  const lbSound = lb?.querySelector<HTMLButtonElement>('[data-lightbox-sound]');
  const lbTitle = lb?.querySelector<HTMLElement>('[data-lightbox-title]');
  const lbSub = lb?.querySelector<HTMLElement>('[data-lightbox-sub]');
  let lbData: Array<{ id: string; title: Record<string, string>; meta: Record<string, string>; year: string; poster: string; aspect: string; preview?: string; preview480?: string; previewMobile?: string }> = [];
  try {
    lbData = JSON.parse(document.querySelector('[data-projects-json]')?.textContent || '[]');
  } catch { lbData = []; }
  const pageLang = (document.documentElement.lang || 'vi').slice(0, 2);
  const fmtTime = (s: number) => {
    if (!isFinite(s) || s < 0) s = 0;
    const m = Math.floor(s / 60);
    const sec = Math.floor(s % 60);
    return `${m}:${String(sec).padStart(2, '0')}`;
  };
  const syncLbTime = () => {
    if (!lbVideo || !lbSeek || !lbTime) return;
    const d = lbVideo.duration || 0;
    lbSeek.value = d > 0 ? String(Math.round((lbVideo.currentTime / d) * 1000)) : '0';
    lbTime.textContent = `${fmtTime(lbVideo.currentTime)} / ${fmtTime(d)}`;
  };
  let lastFocus: HTMLElement | null = null;

  function openLightbox(id: string) {
    const p = lbData.find((x) => x.id === id);
    if (!p || !p.preview || !lb || !lbVideo) return;
    lastFocus = document.activeElement as HTMLElement | null;
    // Exclusive loading: every other video stops fetching right now.
    unloadBackgroundMedia();
    document.dispatchEvent(new CustomEvent('drafty:lightbox', { detail: { open: true } }));
    if (lbTitle) lbTitle.textContent = p.title[pageLang] || p.title.vi;
    if (lbSub) lbSub.textContent = `${p.meta[pageLang] || p.meta.vi} · ${p.year}`;
    lbVideo.poster = p.poster;
    lbVideo.src = p.preview;
    // Drive the panel geometry from the video's real aspect ratio so it is
    // never letterboxed or clipped on any screen shape. Fall back to the
    // declared data aspect until metadata loads.
    const arFromData = (() => {
      const m = (p.aspect || '').match(/(\d+(?:\.\d+)?)\s*\/\s*(\d+(?:\.\d+)?)/);
      return m ? Number(m[1]) / Number(m[2]) : 16 / 9;
    })();
    const applyAr = (ar: number) => {
      lb.style.setProperty('--lb-ar', String(ar));
      lb.style.setProperty('--lb-w', ar >= 1 ? '960px' : '540px');
      lb.toggleAttribute('data-lb-portrait', ar < 1);
    };
    applyAr(arFromData);
    lb.hidden = false;
    lbVideo.muted = false;
    lbVideo.volume = 0.8;
    if (lbVideo.videoWidth > 0) applyAr(lbVideo.videoWidth / lbVideo.videoHeight);
    else lbVideo.addEventListener('loadedmetadata', () => {
      if (!lb.hidden && lbVideo.videoWidth > 0) applyAr(lbVideo.videoWidth / lbVideo.videoHeight);
    }, { once: true });
    document.body.style.overflow = 'hidden';
    lb?.setAttribute('data-lb-sound', '');
    lbVideo.play().then(() => lb?.setAttribute('data-lb-playing', '')).catch(() => {
      // Safari may reject unmuted autoplay: one muted retry, play button stays
      // visible if even that fails so the user can start it directly.
      lbVideo.muted = true;
      lb?.removeAttribute('data-lb-sound');
      lbVideo.play().then(() => lb?.setAttribute('data-lb-playing', '')).catch(() => {});
    });
    lb.querySelector<HTMLButtonElement>('.lightbox-close')?.focus();
  }
  function closeLightbox() {
    if (!lb || !lbVideo) return;
    lbVideo.pause();
    lbVideo.removeAttribute('src');
    lbVideo.load();
    lb.hidden = true;
    lb.removeAttribute('data-lb-portrait');
    lb.removeAttribute('data-lb-playing');
    document.body.style.overflow = '';
    // Background media comes back first, lazily and viewport-aware.
    restoreBackgroundMedia();
    document.dispatchEvent(new CustomEvent('drafty:lightbox', { detail: { open: false } }));
    lastFocus?.focus?.();
  }

  lbVideo?.addEventListener('play', () => lb?.setAttribute('data-lb-playing', ''));
  lbVideo?.addEventListener('pause', () => lb?.removeAttribute('data-lb-playing'));
  lbVideo?.addEventListener('timeupdate', syncLbTime);
  lbVideo?.addEventListener('loadedmetadata', syncLbTime);
  lbPlay?.addEventListener('click', () => {
    if (!lbVideo) return;
    if (lbVideo.paused) lbVideo.play().catch(() => {}); else lbVideo.pause();
  });
  lbSeek?.addEventListener('input', () => {
    if (!lbVideo || !lbVideo.duration) return;
    lbVideo.currentTime = (Number(lbSeek.value) / 1000) * lbVideo.duration;
  });
  lbSound?.addEventListener('click', () => {
    if (!lbVideo) return;
    lbVideo.muted = !lbVideo.muted;
    if (lbVideo.muted) lb?.removeAttribute('data-lb-sound'); else lb?.setAttribute('data-lb-sound', '');
  });
  lb?.querySelectorAll('[data-lightbox-close]').forEach((el) => {
    el.addEventListener('click', closeLightbox);
  });
  window.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && lb && !lb.hidden) closeLightbox();
  });

  // Safety net: if the tab was hidden/suspended, resume all featured loops
  // (muted) on return — they must never stay stopped by themselves.
  // While the lightbox is open, background media stays unloaded by design.
  document.addEventListener('visibilitychange', () => {
    if (document.hidden || reduceMotion || lbOpen()) return;
    featured.forEach((card) => {
      const v = card.querySelector<HTMLVideoElement>('video');
      if (v && v.paused) {
        v.muted = true;
        v.play().catch(() => {});
      }
    });
  });
</script>
