---
import { content, type Lang } from '../data/content';
interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = content[lang];
const items = t.capabilities.items;
---
<section class="section caps" id="capabilities">
  <div class="shell">
    <header class="sec-head reveal">
      <p class="eyebrow">{t.capabilities.eyebrow}</p>
      <h2 class="display-xl">{t.capabilities.title}</h2>
    </header>

    <div class="caps-grid">
      {items.map((item, i) => (
        <article class={`cap-card reveal${i === 0 ? ' cap-feature' : ''}`}>
          <span class="cap-n">{item.n}</span>
          <h3 class="cap-title">{item.title}</h3>
          <p class="cap-desc">{item.desc}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .caps { background: linear-gradient(180deg, transparent, color-mix(in srgb, var(--color-ink-soft) 45%, transparent)); }
  /* Pairs with #work's trimmed bottom padding: combined gap ~64-96px desktop. */
  .caps { padding-top: clamp(1.25rem, 2.5vw, 2rem); }
  .sec-head { margin-bottom: clamp(2.5rem, 5vw, 4rem); }
  .sec-head h2 { margin-top: 0.8rem; }

  .caps-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }
  @media (min-width: 820px) { .caps-grid { grid-template-columns: repeat(3, 1fr); } }

  .cap-card {
    position: relative;
    padding: clamp(1.6rem, 3vw, 2.4rem);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-card);
    background: color-mix(in srgb, var(--color-ink-raised) 70%, transparent);
    display: flex;
    flex-direction: column;
    min-height: 15rem;
    transition: border-color var(--dur-fast) var(--ease-out-soft),
      transform var(--dur-fast) var(--ease-out-soft);
  }
  .cap-card:hover { border-color: color-mix(in srgb, var(--color-gold) 45%, var(--color-line)); }
  .cap-feature { border-color: color-mix(in srgb, var(--color-gold) 55%, var(--color-line)); }
  .cap-feature::before {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: var(--radius-card);
    box-shadow: inset 0 0 60px color-mix(in srgb, var(--color-gold) 10%, transparent);
    pointer-events: none;
  }
  .cap-n { font-family: var(--font-mono); font-size: 0.8rem; color: var(--color-gold); letter-spacing: 0.1em; }
  .cap-title { font-family: var(--font-display); font-size: clamp(1.4rem, 2.4vw, 1.9rem); line-height: 1.1; margin: 1.6rem 0 0.9rem; }
  .cap-desc { color: var(--color-mist); font-size: 0.98rem; line-height: 1.6; margin-top: auto; text-wrap: pretty; }
</style>
