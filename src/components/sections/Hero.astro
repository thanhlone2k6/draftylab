---
import HeroDotGrid from '../interactive/HeroDotGrid';
import HeroLanyard from '../interactive/HeroLanyard';
import { getContent } from '../../i18n';
import type { Locale } from '../../i18n/config';

interface Props { locale: Locale }
const { locale } = Astro.props;
const c = getContent(locale);
const hero = c.hero;
---
<section class="hero" id="top" aria-labelledby="hero-title">
  <div class="hero__bg" aria-hidden="true">
    <HeroDotGrid client:visible />
  </div>

  <div class="hero__inner">
    <div class="hero__copy hero-fade">
      <p class="hero__eyebrow">{hero.eyebrow}</p>
      <h1 id="hero-title" class="hero__title">
        <span>{hero.headline[0]}</span>
        <span>{hero.headline[1]}</span>
      </h1>
      <p class="hero__lead">{hero.lead}</p>
      <div class="hero__ctas">
        <button type="button" class="hbtn hbtn--solid" data-dfl-open="quickcall">
          <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2.5" fill="none" stroke="currentColor" stroke-width="1.8" /><path d="m4 7.5 8 5.5 8-5.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
          {hero.cta}
        </button>
      </div>
    </div>

    <div class="hero__visual hero-unblur">
      <HeroLanyard client:visible portrait="/media/v1-temp/portrait-founder.webp" alt={hero.portraitAlt} />
    </div>
  </div>
</section>

<style>
  /* Layout, type scale and motion follow the React Bits Pro portfolio style (DavidHDev/rbp-portfolio):
     calm two-column hero, Geist medium + tight tracking, muted lead at 65%, rounded-xl CTAs,
     FadeIn (opacity + 12px, 0.8s) for the copy and ScaleUnblur (scale .7→1, blur 20→0, 1s) for the visual. */
  .hero { position: relative; isolation: isolate; overflow: clip; display: flex; align-items: stretch; }
  .hero__bg { position: absolute; inset: 0; z-index: 0; pointer-events: none; }
  .hero__bg::before { content: ''; position: absolute; inset: 0; background: radial-gradient(ellipse 85% 50% at 50% 0%, rgba(250, 250, 250, 0.09), transparent 72%); pointer-events: none; }
  .hero__bg::after { content: ''; position: absolute; inset: 0; background: radial-gradient(ellipse 60% 55% at 25% 50%, rgba(10, 10, 10, 0.8), transparent 72%), linear-gradient(to bottom, transparent 72%, var(--c-bg)); pointer-events: none; }

  .hero__inner { position: relative; z-index: 1; width: 100%; max-width: 1100px; margin-inline: auto; box-sizing: border-box; padding: 128px 24px 40px; display: grid; grid-template-columns: minmax(0, 1fr); align-items: center; gap: 32px; }
  /* The copy column is a query container so the headline can be sized against the space it really has:
     the owner's Vietnamese headline is much longer than "Create more. / Worry less." and at the old
     3.65rem it ran out of the 48% column and under the portrait canvas (2026-10-19). */
  .hero__copy { position: relative; z-index: 2; display: flex; flex-direction: column; gap: 16px; container-type: inline-size; }

  .hero__eyebrow { margin: 0; font-size: 20px; line-height: 1.2; letter-spacing: -0.02em; font-weight: 500; color: var(--c-fg); }
  .hero__title { margin: 0; display: flex; flex-direction: column; font-weight: 500; letter-spacing: -0.035em; line-height: 1.05; font-size: 2.75rem; color: var(--c-fg); }
  .hero__title span { white-space: nowrap; }
  .hero__lead { margin: 0; max-width: 40ch; font-size: 1.125rem; line-height: 1.45; letter-spacing: -0.015em; color: color-mix(in srgb, var(--c-fg) 65%, transparent); }
  .hero__ctas { display: flex; flex-wrap: wrap; align-items: center; gap: 12px; margin-top: 8px; }

  .hbtn { display: inline-flex; align-items: center; gap: 8px; min-height: 44px; padding: 0 20px; border-radius: 12px; font-size: 0.875rem; font-weight: 500; line-height: 1; text-decoration: none; cursor: pointer; border: 1px solid transparent; transition: background-color 300ms var(--ease-out), transform 200ms var(--ease-out); }
  .hbtn:active { transform: scale(0.98); }
  .hbtn svg { width: 16px; height: 16px; flex: none; }
  .hbtn--solid { background: var(--c-fg); color: var(--c-bg); }
  .hbtn--solid:hover { background: color-mix(in srgb, var(--c-fg) 88%, transparent); }

  /* Mobile / tablet: the founder card sits ABOVE the copy, with room for the lanyard strap. */
  .hero__visual { position: relative; order: -1; width: min(100%, 420px); min-height: 66vh; justify-self: center; }

  /* Motion (pure CSS: runs on first paint, independent of hydration; reduced motion handled globally). */
  .hero-fade { animation: hero-fade-in 800ms cubic-bezier(0.22, 1, 0.36, 1) both; }
  .hero-unblur { transform-origin: center; animation: hero-scale-unblur 1000ms cubic-bezier(0.22, 1, 0.36, 1) 80ms both; }
  @keyframes hero-fade-in { from { opacity: 0; transform: translateY(12px); } }
  @keyframes hero-scale-unblur { from { opacity: 0; transform: scale(0.7); filter: blur(20px); } }

  @media (min-width: 768px) {
    .hero__inner { padding-inline: 40px; }
    .hero__title { font-size: 2.5rem; }
    .hero__lead { font-size: 1.25rem; }
  }
  @media (min-width: 1024px) {
    .hero { min-height: min(100dvh, 900px); }
    .hero__inner { padding-block: 112px 48px; }
    .hero__title { font-size: min(3.65rem, 8cqi); }
    .hero__lead { font-size: 1.375rem; max-width: 36ch; }
    .hero__copy { max-width: 48%; }
    /* The Lanyard canvas spans the FULL hero height on the right (half the width, so the card has room to swing),
       so the strap hangs from the top edge and the card is never cut off by the canvas bounds. */
    .hero__inner { position: static; max-width: none; padding-inline: max(40px, calc((100vw - 1100px) / 2)); }
    .hero__visual { position: absolute; z-index: 1; top: 0; right: 0; bottom: 0; width: 50%; min-height: 0; justify-self: auto; }
  }
  @media (max-width: 1023px) {
    .hero__title { white-space: normal; }
    /* Pull the canvas up behind the floating pill (which ends at 64–72px): the strap then grows out
       from under the header instead of hanging from an invisible point in mid-air. */
    .hero__inner { padding-top: 60px; }
    /* The canvas height follows the viewport, so the card is neither cut off on short screens
       nor left floating in a tall empty column on big ones. */
    .hero__visual { height: clamp(220px, 54dvh, 600px); min-height: 0; }
  }

  /* Phone: canvas, gaps and type all scale with the viewport height (dvh), so on any phone aspect
     ratio the card AND the whole copy stay on screen together — nothing gets cropped or pushed
     below the fold. The clamps are the floors: below ~450px of viewport height the type stops
     shrinking and the page starts to scroll instead of cutting anything off. */
  @media (max-width: 767px) {
    .hero__inner { padding: clamp(52px, 7dvh, 60px) 20px clamp(16px, 3dvh, 26px); gap: clamp(8px, 1.6dvh, 14px); }
    .hero__visual { height: clamp(150px, 50dvh, 460px); }
    .hero__copy { gap: clamp(8px, 1.6dvh, 14px); }
    .hero__eyebrow { font-size: clamp(0.875rem, 2.4dvh, 1.0625rem); }
    .hero__title { font-size: min(clamp(1.5rem, 4.1dvh, 2.125rem), 8cqi); }
    .hero__lead { font-size: clamp(0.8125rem, 2.3dvh, 1rem); line-height: 1.4; }
    .hero__ctas { margin-top: 4px; }
  }

  /* Very short phones (browser bars open, landscape-ish windows): give the canvas a little less,
     so the CTA row stays above the fold instead of hanging just past it. */
  @media (max-width: 767px) and (max-height: 700px) {
    .hero__visual { height: clamp(140px, 45dvh, 320px); }
  }
  @media (max-width: 767px) and (max-height: 540px) {
    .hero__visual { height: clamp(140px, 43dvh, 240px); }
  }
</style>
