---
// Social Production. 2026-10-18: the drifting brand rail was replaced by a React Bits CircularCarousel
// in the panorama preset (see components/interactive/SocialCarousel.tsx) — every photo is one card and
// the ring drifts forever. The old rail/folder components are parked, not deleted.
import SocialCarousel from '../interactive/SocialCarousel';
import { social } from '../../data/content';
---
<section class="sp" id={social.id} aria-labelledby="sp-title">
  <div class="container-x">
    <p class="kicker">{social.kicker}</p>
    <h2 id="sp-title" class="section-title">{social.title}</h2>
    <div class="sp__ring">
      <SocialCarousel client:visible={{ rootMargin: '400px' }} />
    </div>
  </div>
</section>

<style>
  .sp { padding-block: var(--section-y); }
  .sp .container-x { position: relative; }
  /* The ring needs a sized, positioned box: the carousel fills it and scales the cards to fit. */
  .sp__ring { position: relative; height: clamp(380px, 56vh, 620px); margin-top: 28px; }
</style>
