---
// Landing page, under Quick Call: the "join the community" card (React Bits GlareHover).
// The crowd photo is optional: drop it at public/media/community/join-crowd.jpg and rebuild.
import { existsSync } from 'node:fs';
import { fileURLToPath } from 'node:url';
import GlareHover from '../react-bits/GlareHover';
import { getContent } from '../../i18n';
import { communityPath } from '../../i18n/config';
import type { Locale } from '../../i18n/config';

interface Props { locale: Locale }
const { locale } = Astro.props;
const c = getContent(locale).community;
const photo = fileURLToPath(new URL('../../../public/media/community/join-crowd.jpg', import.meta.url));
const hasPhoto = existsSync(photo);
---
<section class="cjoin" aria-labelledby="cjoin-title">
  <div class="container-x">
    <GlareHover
      className="cjoin__glare"
      width="100%"
      height="auto"
      borderRadius="30px"
      borderColor="rgba(255, 255, 255, 0.10)"
      background="#101014"
      mode="hover"
      variant="streak"
      glareColor="#ffffff"
      glareOpacity={0.34}
      glareSize={26}
      softness={0.65}
      glareAngle={-30}
      transitionDuration={900}
      playOnce
      intro
      client:visible
    >
      <a class={`cjoin__card${hasPhoto ? ' has-photo' : ''}`} href={communityPath(locale)}>
        {hasPhoto && <img class="cjoin__photo" src="/media/community/join-crowd.jpg" alt="" loading="lazy" />}
        <span class="cjoin__scrim" aria-hidden="true"></span>
        <span class="cjoin__content">
          <span class="cjoin__eyebrow">{c.joinEyebrow}</span>
          <span class="cjoin__title" id="cjoin-title">{c.joinTitle}</span>
          <span class="cjoin__lead">{c.joinLead}</span>
          <span class="cjoin__cta">
            {c.joinCta}
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M5 12h14M13 6l6 6-6 6" />
            </svg>
          </span>
        </span>
      </a>
    </GlareHover>
  </div>
</section>

<style is:global>
  .cjoin { padding-block: clamp(6px, 1.6vw, 20px) clamp(56px, 9vw, 120px); }
  .cjoin .container-x { max-width: 1160px; }
  .cjoin__glare { display: grid; width: 100%; }
  .cjoin__card {
    position: relative;
    display: flex;
    align-items: flex-end;
    width: 100%;
    min-height: clamp(300px, 34vw, 440px);
    padding: clamp(26px, 4vw, 52px);
    box-sizing: border-box;
    overflow: hidden;
    border-radius: inherit;
    color: #fff;
    text-decoration: none;
    background:
      radial-gradient(120% 150% at 82% 8%, rgba(197, 156, 74, 0.42), transparent 56%),
      radial-gradient(90% 130% at 8% 100%, rgba(104, 79, 180, 0.32), transparent 60%),
      linear-gradient(120deg, #17151c 0%, #0d0d10 62%);
  }
  .cjoin__photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 40%;
  }
  .cjoin__scrim { position: absolute; inset: 0; background: linear-gradient(90deg, rgba(0, 0, 0, 0.28), transparent 62%); }
  .cjoin__card.has-photo .cjoin__scrim {
    background:
      linear-gradient(90deg, rgba(6, 6, 8, 0.84) 0%, rgba(6, 6, 8, 0.55) 44%, rgba(6, 6, 8, 0.1) 100%),
      linear-gradient(0deg, rgba(6, 6, 8, 0.74) 0%, transparent 48%);
  }
  .cjoin__content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 12px;
    max-width: 780px;
  }
  .cjoin__eyebrow {
    font-size: 0.76rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.66);
  }
  .cjoin__title {
    font-size: clamp(2rem, 4.6vw, 3.6rem);
    font-weight: 650;
    line-height: 1.02;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }
  .cjoin__lead {
    max-width: 48ch;
    color: rgba(255, 255, 255, 0.74);
    font-size: clamp(0.95rem, 1.4vw, 1.08rem);
    line-height: 1.5;
  }
  .cjoin__cta {
    margin-top: 8px;
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 48px;
    padding: 0 22px;
    border-radius: 999px;
    background: #f4f4f5;
    box-shadow: 0 14px 34px -16px rgba(0, 0, 0, 0.9);
    color: #141418;
    font: inherit;
    font-size: 0.95rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    transition: background var(--dur), transform var(--dur), box-shadow var(--dur);
  }
  .cjoin__cta svg { transition: transform var(--dur); }
  @media (hover: hover) {
    .cjoin__card:hover .cjoin__cta { background: #fff; box-shadow: 0 18px 40px -16px rgba(0, 0, 0, 0.95); }
    .cjoin__card:hover .cjoin__cta svg { transform: translateX(3px); }
  }
  .cjoin__card:focus-visible { outline: 2px solid var(--c-focus); outline-offset: 4px; }
  @media (max-width: 640px) {
    .cjoin__card { min-height: 320px; }
    .cjoin__content { gap: 10px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .cjoin__cta, .cjoin__cta svg { transition: none; }
  }
</style>
