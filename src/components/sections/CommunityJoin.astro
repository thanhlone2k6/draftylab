---
// Landing page, under Quick Call: the "join the community" card (React Bits GlareHover).
// Photo on the right on desktop; full-bleed at 60% opacity behind the copy on phones.
import { existsSync } from 'node:fs';
import { fileURLToPath } from 'node:url';
import GlareHover from '../react-bits/GlareHover';
import WaitlistProgress from '../interactive/WaitlistProgress';
import { getContent } from '../../i18n';
import { communityPath } from '../../i18n/config';
import type { Locale } from '../../i18n/config';

interface Props { locale: Locale }
const { locale } = Astro.props;
const content = getContent(locale);
const c = content.community;
const photo = fileURLToPath(new URL('../../../public/media/community/join-community.jpg', import.meta.url));
const hasPhoto = existsSync(photo);
---
<section class="cjoin" aria-labelledby="cjoin-title">
  <div class="container-x">
    <GlareHover
      className="cjoin__glare"
      width="100%"
      height="auto"
      borderRadius="30px"
      borderColor="rgba(255, 255, 255, 0.10)"
      background="#101014"
      mode="hover"
      variant="streak"
      glareColor="#ffffff"
      glareOpacity={0.34}
      glareSize={26}
      softness={0.65}
      glareAngle={-30}
      transitionDuration={900}
      playOnce
      intro
      client:visible
    >
      <a class={`cjoin__card${hasPhoto ? ' has-photo' : ''}`} href={communityPath(locale)}>
        {hasPhoto && (
          <span class="cjoin__media" aria-hidden="true">
            <img class="cjoin__photo" src="/media/community/join-community.jpg" alt="" loading="lazy" />
          </span>
        )}
        <span class="cjoin__scrim" aria-hidden="true"></span>
        <span class="cjoin__content">
          <span class="cjoin__eyebrow">{c.joinEyebrow}</span>
          <span class="cjoin__title" id="cjoin-title">{c.joinTitle}</span>
          <span class="cjoin__lead">{c.joinLead}</span>
          <WaitlistProgress
            className="cjoin__waitlist"
            label={content.waitlist.homeLabel}
            remaining={content.waitlist.homeRemaining}
            client:visible
          />
          <span class="cjoin__cta">
            {c.joinCta}
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M5 12h14M13 6l6 6-6 6" />
            </svg>
          </span>
        </span>
      </a>
    </GlareHover>
  </div>
</section>

<style is:global>
  .cjoin { padding-block: clamp(6px, 1.6vw, 20px) clamp(56px, 9vw, 120px); }
  .cjoin .container-x { max-width: 1160px; }
  .cjoin__glare { display: grid; width: 100%; }
  .cjoin__card {
    position: relative;
    display: flex;
    align-items: flex-end;
    width: 100%;
    min-height: clamp(300px, 34vw, 440px);
    padding: clamp(26px, 4vw, 52px);
    box-sizing: border-box;
    overflow: hidden;
    border-radius: inherit;
    color: #fff;
    text-decoration: none;
    background:
      radial-gradient(90% 140% at 8% 100%, rgba(31, 111, 235, 0.24), transparent 58%),
      linear-gradient(112deg, #111827 0%, #0b0f16 58%);
  }
  .cjoin__media {
    position: absolute;
    inset: 0 0 0 auto;
    width: 46%;
    overflow: hidden;
  }
  .cjoin__photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 58%;
  }
  /* Blend the photo's left edge into the card instead of a hard seam. */
  .cjoin__media::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, #0f0e12 0%, rgba(15, 14, 18, 0.72) 14%, rgba(15, 14, 18, 0) 46%),
      linear-gradient(0deg, rgba(10, 10, 12, 0.35) 0%, transparent 42%);
  }
  .cjoin__scrim { position: absolute; inset: 0; background: linear-gradient(90deg, rgba(8, 8, 10, 0.3), transparent 58%); }
  .cjoin__content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 12px;
    max-width: 58%;
  }
  .cjoin__eyebrow {
    font-size: 0.76rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.66);
  }
  .cjoin__title {
    font-size: clamp(2rem, 4.6vw, 3.6rem);
    font-weight: 650;
    line-height: 1.02;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }
  .cjoin__lead {
    max-width: 44ch;
    color: rgba(255, 255, 255, 0.74);
    font-size: clamp(0.95rem, 1.4vw, 1.08rem);
    line-height: 1.5;
  }
  .cjoin__waitlist { margin-top: 4px; margin-bottom: 2px; }
  .cjoin__cta {
    margin-top: 8px;
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 48px;
    padding: 0 22px;
    border-radius: 999px;
    background: #f4f4f5;
    box-shadow: 0 14px 34px -16px rgba(0, 0, 0, 0.9);
    color: #141418;
    font: inherit;
    font-size: 0.95rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    transition: background var(--dur), transform var(--dur), box-shadow var(--dur);
  }
  .cjoin__cta svg { transition: transform var(--dur); }
  @media (hover: hover) {
    .cjoin__card:hover .cjoin__cta { background: #fff; box-shadow: 0 18px 40px -16px rgba(0, 0, 0, 0.95); }
    .cjoin__card:hover .cjoin__cta svg { transform: translateX(3px); }
  }
  .cjoin__card:focus-visible { outline: 2px solid var(--c-focus); outline-offset: 4px; }

  /* Phones: the photo goes behind the whole card at 60% so the copy stays readable. */
  @media (max-width: 760px) {
    .cjoin__card { min-height: 340px; }
    .cjoin__media { inset: 0; width: 100%; }
    .cjoin__photo { opacity: 0.6; }
    .cjoin__media::after {
      background: linear-gradient(180deg, rgba(10, 10, 12, 0.25) 0%, rgba(10, 10, 12, 0.55) 100%);
    }
    .cjoin__scrim { background: linear-gradient(90deg, rgba(8, 8, 10, 0.5) 0%, rgba(8, 8, 10, 0.12) 100%); }
    .cjoin__content { max-width: 100%; gap: 10px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .cjoin__cta, .cjoin__cta svg { transition: none; }
  }
</style>
