---
// The Community tab (owner, 2026-11-05): the 3 newest resources, on phone and desktop alike.
import Header from '../Header.astro';
import Footer from '../Footer.astro';
import CommunityGrid from '../interactive/CommunityGrid';
import SkillList from '../interactive/SkillList';
import Waitlist from '../interactive/Waitlist';
import CustomSkillOffer from './CustomSkillOffer.astro';
import BrandIcon from '../BrandIcon.astro';
import { getContent } from '../../i18n';
import { privacyPath } from '../../i18n/config';
import type { Locale } from '../../i18n/config';

interface Props { locale: Locale }
const { locale } = Astro.props;
const content = getContent(locale);
const c = content.community;
// 2026-11-07 (owner): the platform row under the page lead — Facebook, Instagram, TikTok, full-colour
// brand badges ("dùng logo thật").
const communityLinks = [
  { key: 'facebook' as const, label: 'Facebook', href: content.contact.facebook },
  { key: 'instagram' as const, label: 'Instagram', href: content.contact.instagram },
  { key: 'tiktok' as const, label: 'TikTok', href: content.contact.tiktok },
];
---
<Header locale={locale} page="community" />
<main id="main" class="cmt">
  <div class="container-x cmt__inner">
    <h1 class="section-title">{c.title}</h1>
    <p class="section-lead">{c.lead}</p>
    <ul class="cmt-social">
      {communityLinks.map((p) => (
        <li>
          <a class="cmt-social__link" href={p.href} target="_blank" rel="noopener noreferrer" aria-label={p.label}>
            <BrandIcon name={p.key} />
          </a>
        </li>
      ))}
    </ul>
    {c.note && <p class="cmt__note">{c.note}</p>}
    <Waitlist locale={locale} copy={content.waitlist} privacyHref={privacyPath(locale)} client:visible />
    <section class="cmt-skills" aria-labelledby="cmt-skills-title">
      <h2 id="cmt-skills-title" class="cmt-skills__title">{c.skillsTitle}</h2>
      <p class="cmt-skills__lead">{c.skillsLead}</p>
      <SkillList client:load copy={{ error: c.error, retry: c.retry, empty: c.skillsEmpty }} />
    </section>
    <div class="cmt__grid">
      <CommunityGrid
        client:load
        locale={locale}
        copy={{ empty: c.empty, error: c.error, retry: c.retry, posted: c.posted, seeMore: c.seeMore, showLess: c.showLess }}
      />
    </div>
    <CustomSkillOffer locale={locale} />
  </div>
</main>
<Footer locale={locale} />
<style is:global>
  .cmt { min-height: 72dvh; padding-top: calc(var(--header-h) + clamp(24px, 5vw, 56px)); padding-bottom: var(--section-y); }
  .cmt__inner { max-width: 1000px; }
  .cmt__note { margin: 8px 0 0; color: var(--c-fg-faint); font-size: 0.9rem; }

  /* 2026-11-07 (owner): the platform row directly under "Những tài liệu mới nhất dành cho cộng đồng." —
     the owner's real logo art (Facebook + TikTok round, Instagram a rounded square). The link never
     clips or rounds the image; the shadow follows the silhouette via drop-shadow. */
  .cmt-social { list-style: none; display: flex; gap: 10px; margin: 18px 0 0; padding: 0; }
  .cmt-social__link {
    display: block;
    width: 44px;
    height: 44px;
    filter: drop-shadow(0 8px 12px rgba(0, 0, 0, 0.55));
    transition: transform 200ms var(--ease-out), filter 200ms var(--ease-out);
  }
  .cmt-social__link img { display: block; width: 100%; height: 100%; border: 0; border-radius: 0; }
  @media (hover: hover) {
    .cmt-social__link:hover { transform: translateY(-2px); filter: drop-shadow(0 12px 16px rgba(0, 0, 0, 0.6)); }
  }
  .cmt-social__link:focus-visible { outline: 2px solid var(--c-focus); outline-offset: 4px; border-radius: 10px; }
  @media (prefers-reduced-motion: reduce) {
    .cmt-social__link { transition: none; }
    .cmt-social__link:hover { transform: none; }
  }
  .cmt__grid { margin-top: clamp(24px, 4vw, 40px); }
  .cmt__state { display: grid; justify-items: start; gap: 16px; margin: 0; color: var(--c-fg-muted); }
  .cmt__state p { margin: 0; }

  /* "Skill AI x Claude" shelf, above the resource cards. */
  .cmt-skills { margin-top: clamp(26px, 4vw, 44px); }
  .cmt-skills__title { margin: 0; font-size: clamp(1.15rem, 2.4vw, 1.45rem); font-weight: 650; letter-spacing: -0.02em; }
  .cmt-skills__lead { margin: 6px 0 16px; max-width: 62ch; color: var(--c-fg-muted); font-size: 0.95rem; line-height: 1.55; }
  /* Slightly larger cover on the shelf (the component default is 36px). */
  .cmt-skills .animated-list__lead { width: 44px; height: 44px; border-radius: 12px; }
  .cmt-skills .animated-list__title { font-size: 15px; }
  .cmt-skills__skel {
    display: grid;
    gap: 8px;
    width: min(100%, 572px);
    padding: 6px;
    box-sizing: border-box;
    border: 1px solid var(--c-line);
    border-radius: 26px;
    background: var(--c-bg-card);
  }
  .cmt-skills__skel span { height: 56px; border-radius: 14px; background: var(--c-bg-raised); animation: cmt-pulse 1.4s ease-in-out infinite; }
  @media (max-width: 640px) {
    .cmt-skills__lead { font-size: 0.9rem; }
    .cmt-skills__skel { border-radius: 20px; }
    .cmt-skills__skel span { height: 52px; }
  }
  .cmt__skeletons { display: grid; gap: 16px; grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .cmt__skeleton:nth-child(4) { display: none; }
  .cmt__skeleton { aspect-ratio: 1 / 1; border-radius: 22px; background: var(--c-bg-card); animation: cmt-pulse 1.4s ease-in-out infinite; }
  @keyframes cmt-pulse { 50% { opacity: 0.55; } }

  /* Blurred next row (desktop) with the "see more" button on top. */
  .cmt-teaser { position: relative; margin-top: 16px; }
  .cmt-teaser__blur {
    opacity: 0.68;
    filter: blur(7px) saturate(0.9);
    pointer-events: none;
    user-select: none;
  }
  .cmt-teaser__cover {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    padding: 16px;
    background: radial-gradient(46% 52% at 50% 50%, rgba(8, 8, 10, 0.78), rgba(8, 8, 10, 0) 100%);
  }
  .cmt-teaser__cover .cmt-more { pointer-events: auto; }

  .cmt-more-row { display: flex; justify-content: center; margin-top: 22px; }
  .cmt-more {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 48px;
    padding: 0 24px;
    border: 1px solid rgba(255, 255, 255, 0.45);
    border-radius: 999px;
    background: rgba(244, 244, 245, 0.94);
    box-shadow: 0 14px 34px -16px rgba(0, 0, 0, 0.9), 0 0 0 5px rgba(255, 255, 255, 0.06);
    color: #131318;
    font: inherit;
    font-size: 0.95rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    cursor: pointer;
    transition: background var(--dur), box-shadow var(--dur), transform var(--dur);
  }
  .cmt-more svg { transition: transform var(--dur); }
  @media (hover: hover) {
    .cmt-more:hover { background: #fff; box-shadow: 0 18px 40px -16px rgba(0, 0, 0, 0.95), 0 0 0 6px rgba(255, 255, 255, 0.1); }
    .cmt-more:hover svg { transform: translateY(2px); }
  }
  .cmt-more:focus-visible { outline: 2px solid var(--c-focus); outline-offset: 3px; }
  .cmt-more--less {
    background: transparent;
    box-shadow: none;
    border-color: var(--c-line-strong);
    color: var(--c-fg);
  }

  /* Desktop: exactly one solid row (3), the 4th card only completes the 2 × 2 row on phones. */
  @media (min-width: 641px) {
    .cmt-grid:not(.is-expanded) .cmt-grid__main .chroma-card:nth-child(4) { display: none; }
    .cmt-grid:not(.is-expanded) .cmt-more-inline { display: none; }
  }
  @media (max-width: 640px) {
    .cmt-teaser { display: none; }
    .cmt__skeletons { gap: 10px; grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .cmt__skeleton:nth-child(4) { display: block; }
    .cmt__skeleton { border-radius: 16px; }
  }
  @media (prefers-reduced-motion: reduce) { .cmt__skeleton { animation: none; } }
</style>
