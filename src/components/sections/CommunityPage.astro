---
// The Community tab (owner, 2026-11-05): the 3 newest resources, on phone and desktop alike.
import Header from '../Header.astro';
import Footer from '../Footer.astro';
import CommunityGrid from '../interactive/CommunityGrid';
import { getContent } from '../../i18n';
import type { Locale } from '../../i18n/config';

interface Props { locale: Locale }
const { locale } = Astro.props;
const c = getContent(locale).community;
---
<Header locale={locale} page="community" />
<main id="main" class="cmt">
  <div class="container-x cmt__inner">
    <h1 class="section-title">{c.title}</h1>
    <p class="section-lead">{c.lead}</p>
    {c.note && <p class="cmt__note">{c.note}</p>}
    <div class="cmt__grid">
      <CommunityGrid client:load copy={{ empty: c.empty, error: c.error, retry: c.retry }} />
    </div>
  </div>
</main>
<Footer locale={locale} />
<style is:global>
  .cmt { min-height: 72dvh; padding-top: calc(var(--header-h) + clamp(24px, 5vw, 56px)); padding-bottom: var(--section-y); }
  .cmt__inner { max-width: 1160px; }
  .cmt__note { margin: 8px 0 0; color: var(--c-fg-faint); font-size: 0.9rem; }
  .cmt__grid { margin-top: clamp(24px, 4vw, 40px); }
  .cmt__state { display: grid; justify-items: start; gap: 16px; margin: 0; color: var(--c-fg-muted); }
  .cmt__state p { margin: 0; }
  .cmt__skeletons { display: grid; gap: 16px; grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr)); }
  .cmt__skeleton { aspect-ratio: 4 / 3; border-radius: 22px; background: var(--c-bg-card); animation: cmt-pulse 1.4s ease-in-out infinite; }
  @keyframes cmt-pulse { 50% { opacity: 0.55; } }
  @media (prefers-reduced-motion: reduce) { .cmt__skeleton { animation: none; } }
</style>
