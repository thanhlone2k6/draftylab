---
import FadeContent from '../react-bits/FadeContent';
import TiltedCard from '../react-bits/TiltedCard';
import CaseVideoCard from '../interactive/CaseVideoCard';
import { getMedia } from '../../lib/media';
import { cases } from '../../data/content';

// Images only (owner, 2026-10-18): no card frame and no copy — the phone screenshot IS the card. The
// brand name + follower count live in the TiltedCard's cursor tooltip (and in the alt text so screen
// readers still get them); the shared caveat line was removed too (owner). No "result" claim is made
// anywhere in this section — see docs/phase2-mapping.md. Screenshots are cropped to the device at build
// time (scripts/media-roles.json).
const shots = cases.items
  .map((c) => ({ ...c, media: getMedia(c.mediaId) }))
  .filter((c) => c.media) as Array<(typeof cases.items)[number] & { media: NonNullable<ReturnType<typeof getMedia>> }>;
// Video cards (owner, 2026-10-18): hover plays the short preview in the card, the pill opens the original post.
const videos = cases.videos
  .map((v) => ({ ...v, media: getMedia(v.mediaId) }))
  .filter((v) => v.media?.previewSrc) as Array<(typeof cases.videos)[number] & { media: NonNullable<ReturnType<typeof getMedia>> }>;
const vc = cases.videoCopy;
---
{shots.length > 0 && (
  <section class="cs" id={cases.id} aria-labelledby="cs-title">
    <div class="container-x">
      <FadeContent client:load blur={4} duration={0.6} threshold={0.15} initialOpacity={0}>
        <p class="kicker">{cases.kicker}</p>
        <h2 id="cs-title" class="section-title">{cases.title}</h2>
        <p class="section-lead">{cases.lead}</p>
      </FadeContent>

      <ul class="cs__grid">
        {shots.map((c, i) => (
          <li class="cs__shot">
            <TiltedCard
              client:visible={{ rootMargin: '300px' }}
              imageSrc={c.media.posterSrc}
              altText={c.media.alt}
              captionText={`${c.name} · ${c.followers} người theo dõi`}
              containerWidth="100%"
              containerHeight="100%"
              imageWidth="var(--cs-shot-w)"
              imageHeight="var(--cs-shot-h)"
              rotateAmplitude={12}
              scaleOnHover={1.05}
              perspective={800}
              smoothness={0.6}
              glare={0.5}
              shadow={0.5}
              parallax={1}
              radius={15}
              intro
              introDelay={i * 90}
            />
          </li>
        ))}
      </ul>

      {videos.length > 0 && (
        <ul class="cs__videos">
          {videos.map((v) => (
            <li class="cs__video">
              <CaseVideoCard
                client:visible={{ rootMargin: '300px' }}
                platform={v.platform}
                platformName={v.platformName}
                views={v.views}
                viewsTo={v.viewsTo}
                viewsDecimals={v.viewsDecimals}
                creator={v.creator}
                viewsLabel={vc.viewsLabel}
                url={v.url}
                ctaLabel={vc.cta(v.platformName)}
                ariaLabel={vc.aria(v.platformName, v.views)}
                posterSrc={v.media.posterSrc}
                previewSrc={v.media.previewSrc!}
                aspect={v.media.aspectRatio}
                hasAudio={v.hasAudio}
                playLabel={vc.play}
                pauseLabel={vc.pause}
                muteLabel={vc.mute}
                unmuteLabel={vc.unmute}
                seekLabel={vc.seek}
              />
            </li>
          ))}
        </ul>
      )}
    </div>
  </section>
)}

<style>
  .cs { padding-block: var(--section-y); }
  .cs__grid { list-style: none; margin: 24px 0 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: clamp(10px, 1.4vw, 18px); }
  /* A cell is just the tilt stage: the phone (1160×2370 → aspect 0.4895, transparent frame cropped at
     build time) floats on the page background. --cs-shot-w tracks the viewport so the device takes as
     much of the column as it can while still leaving room for the 1.05 hover scale and the 12° tilt;
     the stage height is the mockup + ~40px so consecutive rows sit close together. No frame on the cell
     either — a border + overflow would clip the tilt, its shadow and the cursor tooltip. */
  .cs__shot { --cs-shot-w: clamp(140px, 15vw, 210px); --cs-shot-h: calc(var(--cs-shot-w) * 2.0423); position: relative; display: grid; place-items: center; height: calc(var(--cs-shot-h) + 44px); padding-top: 10px; box-sizing: border-box; }
  .cs__videos { list-style: none; margin: clamp(28px, 4vw, 48px) auto 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(12px, 2vw, 24px); max-width: 880px; }
  .cs__video { min-width: 0; }
  @media (max-width: 639px) {
    /* Phones: all three video cards in one row (owner, 2026-10-19) — no sideways swipe. */
    .cs__videos { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 8px; max-width: none; }
  }
  @media (max-width: 1023px) {
    .cs__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: clamp(10px, 1.6vw, 16px); }
    .cs__shot { --cs-shot-w: clamp(180px, 27vw, 300px); height: calc(var(--cs-shot-h) + 42px); }
  }
  @media (max-width: 639px) {
    /* Phones: 2 mockups per row, as tight as the tilt allows (owner: bigger, closer together). */
    .cs__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px 6px; margin-top: 18px; }
    .cs__shot { --cs-shot-w: clamp(104px, 36vw, 164px); height: calc(var(--cs-shot-h) + 38px); padding-top: 12px; }
  }
</style>
