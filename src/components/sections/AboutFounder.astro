---
import FadeContent from '../react-bits/FadeContent';
import FounderCard from '../interactive/FounderCard';
import { about } from '../../data/content';
---
<section class="ab" id={about.id} aria-labelledby="ab-title">
  <div class="container-x ab__inner">
    <FadeContent client:load blur={4} duration={0.6} threshold={0.15} initialOpacity={0} className="ab__copy">
      <p class="kicker">{about.kicker}</p>
      <h2 id="ab-title" class="section-title">{about.title}</h2>
      <p class="ab__intro">{about.intro}</p>
      <div class="ab__body">
        {about.body.map((p) => <p set:html={p} />)}
      </div>
    </FadeContent>
    <div class="ab__card">
      <FounderCard client:visible portrait="/media/founder/portrait-founder.webp" alt="Thành Nguyễn — Founder & Creative Lead, Drafty Lab" />
    </div>
  </div>
</section>

<style>
  .ab { padding-block: var(--section-y); }
  .ab__inner { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 0.9fr); gap: clamp(32px, 6vw, 96px); align-items: center; }
  .ab__intro { margin: 24px 0 0; font-size: clamp(1.25rem, 2vw, 1.6rem); line-height: 1.35; letter-spacing: -0.02em; font-weight: 500; max-width: 28ch; }
  .ab__body { margin: 16px 0 0; color: var(--c-fg-muted); line-height: 1.62; max-width: 56ch; }
  .ab__body p { margin: 0 0 12px; }
  .ab__body p:last-child { margin-bottom: 0; }
  .ab__body :global(strong) { color: var(--c-fg); font-weight: 600; }
  /* The 3 tag pills (about.tags) live INSIDE the Founder card now (see .fc__tags in components.css),
     directly under the role. */
  .ab__card { display: grid; place-items: center; min-height: 520px; }
  /* Phones: one column, and the greeting + story move out of here (story goes into the Founder card). */
  @media (max-width: 899px) { .ab__inner { grid-template-columns: 1fr; } .ab__card { min-height: 0; } .ab__intro, .ab__body { display: none; } }
</style>
