---
import { nav, site } from '../data/content';
---
<header class="hdr" data-hdr>
  <nav class="hdr__pill" aria-label="Chính">
    <a class="hdr__logo" href="#top" aria-label={`${site.name} — về đầu trang`}>
      <img src="/media/v1-temp/logo.webp" alt="" width="320" height="81" />
    </a>

    <ul id="hdr-menu" class="hdr__links" data-links>
      <span class="hdr__indicator" aria-hidden="true" data-indicator></span>
      {nav.links.map((l) => (
        <li><a href={l.href} data-section={l.href.slice(1)}>{l.label}</a></li>
      ))}
      <li class="hdr__cta-m"><button type="button" class="hdr__cta-btn" data-dfl-open="quickcall">{nav.cta}</button></li>
    </ul>

    <button type="button" class="hdr__cta" data-dfl-open="quickcall">{nav.cta}</button>
    <button type="button" class="hdr__burger" aria-controls="hdr-menu" aria-expanded="false" data-open-label={nav.menuOpen} data-close-label={nav.menuClose} aria-label={nav.menuOpen}>
      <span></span><span></span>
    </button>
  </nav>
</header>

<script>
  // Floating pill navigation (style: React Bits Pro portfolio). The indicator slides to the section
  // currently in view; menu button + Escape handling for small screens.
  const hdr = document.querySelector<HTMLElement>('[data-hdr]')!;
  const burger = hdr.querySelector<HTMLButtonElement>('.hdr__burger')!;
  const list = hdr.querySelector<HTMLElement>('[data-links]')!;
  const indicator = hdr.querySelector<HTMLElement>('[data-indicator]')!;
  const links = Array.from(list.querySelectorAll<HTMLAnchorElement>('a[data-section]'));

  const setOpen = (open: boolean, focusBurger = false) => {
    hdr.toggleAttribute('data-menu-open', open);
    burger.setAttribute('aria-expanded', String(open));
    burger.setAttribute('aria-label', (open ? burger.dataset.closeLabel : burger.dataset.openLabel) || '');
    if (focusBurger) burger.focus();
  };
  burger.addEventListener('click', () => setOpen(burger.getAttribute('aria-expanded') !== 'true'));
  list.addEventListener('click', (e) => {
    if ((e.target as Element).closest('a, button')) setOpen(false);
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && hdr.hasAttribute('data-menu-open')) setOpen(false, true);
  });
  document.addEventListener('click', (e) => {
    if (hdr.hasAttribute('data-menu-open') && !(e.target as Element).closest('[data-hdr]')) setOpen(false);
  });
  window.matchMedia('(min-width: 900px)').addEventListener('change', (m) => m.matches && setOpen(false));

  let activeId = '';
  let placed = false;
  const place = (animate: boolean) => {
    const el = links.find((l) => l.dataset.section === activeId);
    if (!el || list.offsetParent === null || getComputedStyle(list).position === 'absolute') {
      indicator.style.opacity = '0';
      return;
    }
    indicator.style.transition = animate ? '' : 'none';
    indicator.style.width = `${el.offsetWidth}px`;
    indicator.style.height = `${el.offsetHeight}px`;
    indicator.style.transform = `translate(${el.offsetLeft}px, ${el.offsetTop}px)`;
    indicator.style.opacity = '1';
    placed = true;
  };
  const setActive = (id: string) => {
    if (id === activeId) return;
    activeId = id;
    links.forEach((l) => {
      if (l.dataset.section === id) l.setAttribute('aria-current', 'true');
      else l.removeAttribute('aria-current');
    });
    place(placed);
  };

  // Every section in the page, so a section without its own nav link (Behind the Creative, How I Work…)
  // clears the highlight instead of leaving a stale one.
  const sections = Array.from(document.querySelectorAll<HTMLElement>('main > section[id]'));
  const linked = new Set(links.map((l) => l.dataset.section));
  let raf = 0;
  const spy = () => {
    raf = 0;
    const line = window.innerHeight * 0.4;
    let current = '';
    for (const s of sections) if (s.getBoundingClientRect().top <= line) current = s.id;
    setActive(linked.has(current) ? current : '');
  };
  window.addEventListener('scroll', () => { if (!raf) raf = requestAnimationFrame(spy); }, { passive: true });
  window.addEventListener('resize', () => place(false));
  spy();
</script>

<style>
  .hdr { position: fixed; z-index: 100; top: 24px; left: 0; right: 0; display: flex; justify-content: center; pointer-events: none; }
  .hdr__pill { pointer-events: auto; position: relative; display: flex; align-items: center; gap: 4px; padding: 6px; border-radius: 999px; background: var(--c-bg); border: 1px solid rgba(250, 250, 250, 0.09); box-shadow: 0 8px 30px -12px rgba(0, 0, 0, 0.8); }
  .hdr__logo { display: inline-flex; align-items: center; height: 36px; padding: 0 12px 0 14px; }
  .hdr__logo img { height: 20px; width: auto; display: block; }

  .hdr__links { position: relative; display: flex; align-items: center; gap: 4px; list-style: none; margin: 0; padding: 0; }
  .hdr__indicator { position: absolute; left: 0; top: 0; width: 0; height: 0; border-radius: 999px; background: rgba(250, 250, 250, 0.06); box-shadow: inset 0 0 0 1px rgba(250, 250, 250, 0.09); opacity: 0; pointer-events: none; transition: transform 480ms cubic-bezier(0.34, 1.35, 0.64, 1), width 480ms cubic-bezier(0.34, 1.35, 0.64, 1), height 480ms cubic-bezier(0.34, 1.35, 0.64, 1), opacity 240ms ease; }
  .hdr__links a { position: relative; display: inline-flex; align-items: center; justify-content: center; min-height: 36px; padding: 0 16px; border-radius: 999px; color: color-mix(in srgb, var(--c-fg) 60%, transparent); text-decoration: none; font-size: 0.875rem; font-weight: 500; transition: color 300ms; }
  .hdr__links a:hover, .hdr__links a[aria-current] { color: var(--c-fg); }
  .hdr__cta-m { display: none; }

  .hdr__cta { margin-left: 6px; min-height: 36px; padding: 0 16px; border: 0; border-radius: 999px; background: var(--c-fg); color: var(--c-bg); font-size: 0.875rem; font-weight: 500; cursor: pointer; transition: background-color 300ms, transform 200ms var(--ease-out); }
  .hdr__cta:hover { background: color-mix(in srgb, var(--c-fg) 88%, transparent); }
  .hdr__cta:active { transform: scale(0.97); }
  .hdr__burger { display: none; }

  @media (max-width: 899px) {
    .hdr { top: 16px; }
    .hdr__cta { display: none; }
    .hdr__logo { padding-right: 18px; }
    .hdr__burger { display: inline-grid; place-content: center; gap: 5px; width: 40px; height: 36px; margin-left: 4px; border-radius: 999px; border: 0; background: rgba(250, 250, 250, 0.06); cursor: pointer; }
    .hdr__burger span { display: block; width: 16px; height: 2px; background: var(--c-fg); border-radius: 2px; transition: transform var(--dur) var(--ease-out); }
    .hdr[data-menu-open] .hdr__burger span:first-child { transform: translateY(3.5px) rotate(45deg); }
    .hdr[data-menu-open] .hdr__burger span:last-child { transform: translateY(-3.5px) rotate(-45deg); }

    .hdr__links { position: absolute; top: calc(100% + 8px); left: 50%; translate: -50% 0; width: min(calc(100vw - 32px), 340px); flex-direction: column; align-items: stretch; gap: 2px; padding: 8px; border-radius: 24px; background: var(--c-bg); border: 1px solid rgba(250, 250, 250, 0.09); box-shadow: 0 20px 50px -16px rgba(0, 0, 0, 0.9); display: none; box-sizing: border-box; }
    .hdr[data-menu-open] .hdr__links { display: flex; }
    .hdr__indicator { display: none; }
    .hdr__links a { min-height: 48px; justify-content: flex-start; padding: 0 16px; border-radius: 14px; font-size: 1rem; color: var(--c-fg); }
    .hdr__links a[aria-current] { background: rgba(250, 250, 250, 0.06); }
    .hdr__cta-m { display: block; margin-top: 6px; }
    .hdr__cta-btn { width: 100%; min-height: 48px; border: 0; border-radius: 14px; background: var(--c-fg); color: var(--c-bg); font-size: 1rem; font-weight: 500; cursor: pointer; }
  }
</style>
