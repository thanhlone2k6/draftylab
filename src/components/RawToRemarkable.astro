---
import { content, type Lang } from '../data/content';
interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = content[lang];
---
<section class="section raw" id="raw">
  <div class="shell">
    <header class="sec-head reveal">
      <p class="eyebrow">{t.raw.eyebrow}</p>
      <h2 class="display-xl">{t.raw.title}</h2>
      <p class="lead sec-sub">{t.raw.sub}</p>
    </header>

    <div class="compare reveal" data-compare>
      <div class="compare-frame media-frame">
        <img class="compare-img" src="/media/raw/after.jpg" alt={t.raw.after} width="1400" height="875" />
        <div class="compare-after" data-after>
          <img class="compare-img" src="/media/raw/before.jpg" alt={t.raw.before} width="1400" height="875" />
        </div>
        <span class="compare-label compare-label-before">{t.raw.before}</span>
        <span class="compare-label compare-label-after">{t.raw.after}</span>
        <div class="compare-handle" aria-hidden="true"><span></span></div>
      </div>
      <input
        class="compare-range"
        type="range"
        min="0"
        max="100"
        value="50"
        aria-label={`${t.raw.before} / ${t.raw.after}`}
      />
    </div>
  </div>
</section>

<style>
  .sec-head { margin-bottom: clamp(2.5rem, 5vw, 4rem); max-width: 44rem; }
  .sec-head h2 { margin: 0.8rem 0 1rem; }
  .sec-sub { max-width: 42ch; }

  .compare { max-width: 62rem; }
  .compare-frame { aspect-ratio: 16 / 10; }
  .compare-img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }

  .compare-after {
    position: absolute;
    inset: 0;
    width: var(--reveal, 50%);
    overflow: hidden;
    border-right: 2px solid var(--color-gold);
  }
  .compare-after .compare-img { width: 100%; height: 100%; }

  .compare-label {
    position: absolute;
    bottom: 0.9rem;
    z-index: 3;
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    padding: 0.32rem 0.7rem;
    border-radius: var(--radius-pill);
    background: color-mix(in srgb, var(--color-ink) 62%, transparent);
    border: 1px solid var(--color-line);
  }
  .compare-label-before { left: 0.9rem; color: var(--color-mist); }
  .compare-label-after { right: 0.9rem; color: var(--color-gold); }

  .compare-handle {
    position: absolute;
    top: 0;
    bottom: 0;
    left: var(--reveal, 50%);
    width: 0;
    z-index: 3;
    pointer-events: none;
  }
  .compare-handle span {
    position: absolute;
    top: 50%;
    left: 0;
    transform: translate(-50%, -50%);
    width: 42px;
    height: 42px;
    border-radius: 50%;
    background: var(--color-gold);
    box-shadow: 0 4px 20px rgb(0 0 0 / 0.4);
  }
  .compare-handle span::before,
  .compare-handle span::after {
    content: "";
    position: absolute;
    top: 50%;
    width: 0;
    height: 0;
    border-block: 5px solid transparent;
  }
  .compare-handle span::before { left: 11px; border-right: 6px solid var(--color-ink); transform: translateY(-50%); }
  .compare-handle span::after { right: 11px; border-left: 6px solid var(--color-ink); transform: translateY(-50%); }

  .compare-range {
    width: 100%;
    margin-top: 1.2rem;
    accent-color: var(--color-gold);
    cursor: ew-resize;
  }
</style>
