---
import { content, type Lang } from '../data/content';
import { partners } from '../data/partners';
interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = content[lang];
const loop = [...partners, ...partners];
---
<section class="partners" id="partners">
  <div class="shell partners-head">
    <p class="partners-title reveal">{t.partners.title}</p>
  </div>

  <div class="partners-band" data-marquee>
    <div class="partners-track" data-track>
      {loop.map((p, i) => (
        <a
          class={`partner partner-${p.kind}`}
          href={p.url}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={p.name}
          aria-hidden={i >= partners.length ? 'true' : undefined}
          tabindex={i >= partners.length ? -1 : undefined}
        >
          <img src={p.logo} alt={p.name} loading="lazy" decoding="async" />
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .partners { padding-top: clamp(1.5rem, 4vw, 3rem); padding-bottom: clamp(2rem, 5vw, 3.5rem); }

  .partners-head { margin-bottom: 1.4rem; }
  .partners-title {
    font-size: 0.82rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-mist);
    text-align: center;
  }

  .partners-band {
    position: relative;
    background: var(--color-gold);
    padding-block: clamp(1.1rem, 2.4vw, 1.7rem);
    overflow: hidden;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
  }

  .partners-track {
    display: flex;
    align-items: center;
    gap: clamp(2.5rem, 5vw, 4.5rem);
    width: max-content;
    padding-inline: clamp(2.5rem, 5vw, 4.5rem);
    animation: partner-scroll 34s linear infinite;
    will-change: transform;
  }

  .partner {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: none;
    height: clamp(52px, 6.5vw, 78px);
    transition: transform var(--dur-fast) var(--ease-out-soft);
  }

  /* Mobile: smaller logos so more fit on screen */
  @media (max-width: 640px) {
    .partners-band { padding-block: 0.85rem; }
    .partners-track { gap: 1.8rem; padding-inline: 1.8rem; }
    .partner { height: 40px; }
    .partner-logo img { max-width: 150px; }
  }
  .partner:hover,
  .partner:focus-visible { transform: scale(1.14); }

  .partner-logo img {
    height: 100%;
    width: auto;
    max-width: 220px;
    object-fit: contain;
  }

  .partner-photo img {
    height: 100%;
    width: auto;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    border-radius: 12px;
    box-shadow: 0 4px 16px rgb(16 16 14 / 0.28);
  }

  @keyframes partner-scroll {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }

  @media (prefers-reduced-motion: reduce) {
    .partners-track { animation: none; }
  }
</style>
