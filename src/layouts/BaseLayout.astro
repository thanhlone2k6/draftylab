---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import DevAgentation from '../components/DevAgentation';
import GradientASCII from '../components/GradientASCII';
import { content, type Lang } from '../data/content';
import { r2 } from '../data/media';

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
}
const { lang, title, description } = Astro.props;
const t = content[lang];
const base = Astro.site?.toString().replace(/\/$/, '') ?? 'https://draftylab.pages.dev';
const path = Astro.url.pathname;
const altPath = lang === 'vi' ? (path === '/' ? '/en/' : '/en' + path) : (path.replace(/^\/en/, '') || '/');

const mediaOrigin = new URL(r2('x'), base).origin;
const pageTitle = title ?? (lang === 'vi'
  ? 'Drafty Lab — Studio sản xuất sáng tạo AI'
  : 'Drafty Lab — AI Creative Production Studio');
const pageDesc = description ?? t.hero.sub;
const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Drafty Lab',
  url: base,
  logo: new URL('/media/logo.png', base).toString(),
  description: pageDesc,
});
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/media/logo-mark.png" />
    <link rel="preconnect" href={mediaOrigin} crossorigin />
    <link rel="preload" href="/fonts/SVN-Gratelos-Display.woff2" as="font" type="font/woff2" crossorigin />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDesc} />
    <link rel="canonical" href={new URL(path, base).toString()} />
    <link rel="alternate" hreflang={lang === 'vi' ? 'vi' : 'en'} href={new URL(path, base).toString()} />
    <link rel="alternate" hreflang={lang === 'vi' ? 'en' : 'vi'} href={new URL(altPath, base).toString()} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDesc} />
    <meta property="og:image" content={new URL('/media/hero/showreel-poster.jpg', base).toString()} />
    <meta property="og:url" content={new URL(path, base).toString()} />
    <meta property="og:site_name" content="Drafty Lab" />
    <meta property="og:locale" content={lang === 'vi' ? 'vi_VN' : 'en_US'} />
    <meta property="og:locale:alternate" content={lang === 'vi' ? 'en_US' : 'vi_VN'} />
    <meta property="og:image:alt" content={pageTitle} />
    <meta name="twitter:card" content="summary_large_image" />
    <Fragment set:html={`<script type="application/ld+json">${jsonLd}</script>`} />
    <meta name="theme-color" content="#10100E" />
  </head>
  <body data-site-loading>
    <div class="site-loader" data-site-loader role="status" aria-live="polite" aria-label="Loading Drafty Lab">
      <div class="site-loader__mark" aria-hidden="true">
        <span></span><span></span><span></span>
      </div>
      <p class="site-loader__label">Drafty Lab</p>
    </div>
    <div class="grain" aria-hidden="true"></div>
    {/* Fixed full-site GradientASCII background; pointer-events pass through so the
        scramble/click effect follows the cursor across the whole page. */}
    <div class="site-ascii-bg" aria-hidden="true">
      <GradientASCII
        client:load
        shape="horizon"
        colors={['#0a1440', '#1e3fd8', '#38bdf8', '#a5d8ff']}
        characters=" =+xX0S8#@"
        cellSize={20}
        density={0.7}
        glyphOpacity={0.5}
        gradientOpacity={0.16}
        glow={0.18}
        flicker={0.25}
        softness={0.6}
        flow={0.6}
        speed={1.1}
        scale={1.2}
        grain={0.05}
        mouseInteraction
        scrambleRadius={0.09}
        clickEffect="wave"
        fontFamily="ui-monospace, SFMono-Regular, Menlo, Consolas, monospace"
      />
    </div>
    {/* Global Swarm Cursor overlay (follows mouse across entire site) */}
    <div class="site-swarm-cursor swarm-cursor" data-site-swarm aria-hidden="true">
      <canvas class="swarm-cursor-canvas" aria-hidden="true"></canvas>
    </div>
    <div id="scroll-sentinel" aria-hidden="true" style="position:absolute;top:0;height:1px;width:1px;"></div>
    <a href="#main" class="skip-link">Skip to content</a>
    <Header lang={lang} altPath={altPath} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />
    {import.meta.env.DEV && <DevAgentation client:only="react" />}
    <script>
      // Branded loader: lifts as soon as the hero reel can play (or the page has loaded),
      // never later than 1.5s so a slow video host cannot hold the page hostage.
      let siteReady = false;
      const finishSiteLoad = () => {
        if (siteReady) return;
        siteReady = true;
        document.body.removeAttribute('data-site-loading');
        document.dispatchEvent(new CustomEvent('drafty:ready'));
      };
      window.setTimeout(finishSiteLoad, 1500);
      const heroVideo = document.querySelector<HTMLVideoElement>('.hero-video');
      if (heroVideo && heroVideo.readyState < 3) {
        heroVideo.addEventListener('canplay', () => window.setTimeout(finishSiteLoad, 150), { once: true });
      } else {
        window.addEventListener('load', finishSiteLoad, { once: true });
      }

      // Reveal-on-scroll + nav behaviour + reduced-motion aware
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const revealEls = document.querySelectorAll<HTMLElement>('.reveal');
      if (reduce) {
        revealEls.forEach((el) => el.classList.add('is-in'));
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((e) => {
              if (e.isIntersecting) {
                e.target.classList.add('is-in');
                io.unobserve(e.target);
              }
            });
          },
          { threshold: 0.15, rootMargin: '0px 0px -8% 0px' }
        );
        revealEls.forEach((el) => io.observe(el));
      }

      // Mobile menu
      const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
      const panel = document.querySelector<HTMLElement>('[data-menu-panel]');
      if (toggle && panel) {
        const setOpen = (open: boolean) => {
          panel.toggleAttribute('data-open', open);
          toggle.setAttribute('aria-expanded', String(open));
          document.body.style.overflow = open ? 'hidden' : '';
        };
        toggle.addEventListener('click', () => setOpen(!panel.hasAttribute('data-open')));
        panel.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
        window.addEventListener('keydown', (e) => e.key === 'Escape' && setOpen(false));
      }

      // Language-aware current year (footer)
      const yr = document.querySelector('[data-year]');
      if (yr) yr.textContent = String(new Date().getFullYear());
    </script>
    <script>
      import '../scripts/motion.ts';

      // Desktop interactive particle swarm tracking cursor across the entire page
      const siteSwarm = document.querySelector<HTMLElement>('[data-site-swarm]');
      if (
        siteSwarm &&
        window.matchMedia('(min-width: 768px) and (hover: hover)').matches &&
        !window.matchMedia('(prefers-reduced-motion: reduce)').matches
      ) {
        import('../scripts/swarmCursor.js').then((m) =>
          m.initSwarmCursor(siteSwarm, {
            count: 700,
            size: 2.2,
            spread: 95,
            swirl: 0.6,
            color: '#f5f2eb',
            accentColor: '#e8b83d',
            targets: 'a, button, [role="button"]',
            clickEffect: 'burst',
            idle: 'roam',
          })
        );
      }
    </script>
    <style is:global>
      /* GradientASCII fixed background sits behind all site content;
         pointer events pass through, mouse trail listens on window. */
      header, main, footer { position: relative; z-index: 1; }
      .site-swarm-cursor {
        position: fixed;
        inset: 0;
        z-index: 50;
        pointer-events: none;
      }
      @media (max-width: 767px), (hover: none) {
        .site-swarm-cursor { display: none; }
      }
      .skip-link {
        position: absolute;
        left: -999px;
        top: 0;
        z-index: 100;
        background: var(--color-gold);
        color: var(--color-ink);
        padding: 0.6rem 1rem;
        border-radius: 0 0 8px 0;
        font-weight: 600;
      }
      .skip-link:focus { left: 0; }
    </style>
  </body>
</html>
