---
import '@fontsource-variable/geist';
import '../styles/globals.css';
import '../styles/components.css';
import DialogShell from '../components/media/DialogShell.astro';
import MediaDialogHost from '../components/media/MediaDialogHost';
import VolumeOverlay from '../components/media/VolumeOverlay';
import PageRays from '../components/interactive/PageRays';
import bootstrap from '../scripts/dialog-bootstrap.js?raw';
import volumeStore from '../scripts/volume-store.js?raw';
import audioLevel from '../scripts/audio-level.js?raw';
import { getContent } from '../i18n';
import { LOCALE_META, LOCALES, localePath, type Locale } from '../i18n/config';

interface Props { locale: Locale }
const { locale } = Astro.props;
const c = getContent(locale);
const meta = LOCALE_META[locale];
// Every locale gets its own canonical URL and the full hreflang set (x-default → Vietnamese).
const ORIGIN = 'https://draftylab.pages.dev';
const canonical = `${ORIGIN}${localePath(locale)}`;
// Link-preview card (owner, 2026-10-21): Zalo/Facebook/Messenger showed only the domain + title because
// the page had no og:image. `public/og/og-image.jpg` is a 1200x1200 JPEG made from the brand render
// `logo/design-gen-176648f8293865.png` (that source lives outside the repo, so the file is committed).
const OG_IMAGE = `${ORIGIN}/og/og-image.jpg`;
---
<!doctype html>
<html lang={meta.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{c.site.title}</title>
    <meta name="description" content={c.site.description} />
    <meta name="theme-color" content="#0a0a0a" />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonical} />
    {LOCALES.map((l) => (
      <link rel="alternate" hreflang={LOCALE_META[l].htmlLang} href={`${ORIGIN}${localePath(l)}`} />
    ))}
    <link rel="alternate" hreflang="x-default" href={`${ORIGIN}${localePath('vi')}`} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={meta.ogLocale} />
    {LOCALES.filter((l) => l !== locale).map((l) => (
      <meta property="og:locale:alternate" content={LOCALE_META[l].ogLocale} />
    ))}
    <meta property="og:site_name" content={c.site.name} />
    <meta property="og:title" content={c.site.title} />
    <meta property="og:description" content={c.site.description} />
    <meta property="og:image" content={OG_IMAGE} />
    <meta property="og:image:secure_url" content={OG_IMAGE} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="1200" />
    <meta property="og:image:alt" content={c.site.title} />
    <!-- Twitter/X uses `twitter:*`; without a card it falls back to a small thumbnail. -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={c.site.title} />
    <meta name="twitter:description" content={c.site.description} />
    <meta name="twitter:image" content={OG_IMAGE} />
    <meta name="twitter:image:alt" content={c.site.title} />
    <link rel="icon" type="image/png" href="/media/v1-temp/logo-mark.png" />
    <!-- Boot gate: hold the page for ~800ms on the first load of a session so the first-paint effects
         (hero WebGL card, GlassSurface nav, the social ring's images) can initialise behind the scenes
         instead of flickering in. Skipped on repeat visits in the same session, under reduced motion,
         and on any error — the page must never stay hidden. Styles: `html[data-boot] body` below. -->
    <script is:inline>
      (() => {
        const root = document.documentElement;
        try {
          if (sessionStorage.getItem('dfl-boot')) return;
          sessionStorage.setItem('dfl-boot', '1');
          if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
          root.setAttribute('data-boot', '');
          window.setTimeout(() => root.removeAttribute('data-boot'), 800);
        } catch {
          root.removeAttribute('data-boot');
        }
      })();
    </script>
  </head>
  <body>
    <a class="skip" href="#main">{c.site.skipLink}</a>
    <div class="site-frame" aria-hidden="true"></div>
    <PageRays client:load />
    <slot />
    <DialogShell locale={locale} />
    <!-- Runs immediately: CTAs/posters open the dialog on the very first click, before hydration. -->
    <script is:inline set:html={volumeStore} />
    <!-- Level bridge: iOS Safari ignores `video.volume`, so the level is applied through a Web Audio gain there. -->
    <script is:inline set:html={audioLevel} />
    <script is:inline set:html={bootstrap} />
    <MediaDialogHost client:load locale={locale} />
    <!-- In-place volume gauge for touch devices; opens when a running preview is tapped again. -->
    <VolumeOverlay client:load locale={locale} />
    <!-- 2026-10-21 (owner): a language switch must not lose the reader's place. The switcher stashes
         scrollY under `dfl-lang-scroll` right before navigating; this restores it after the destination
         has laid out (media boxes reserve their height in CSS, so the pixel offset maps 1:1). Runs at the
         end of <body>, when the document is fully parsed. No stored value on a normal visit → no-op. -->
    <script is:inline>
      (() => {
        try {
          const KEY = 'dfl-lang-scroll';
          const saved = sessionStorage.getItem(KEY);
          if (saved == null) return;
          sessionStorage.removeItem(KEY);
          const top = parseInt(saved, 10);
          if (!top || top < 1) return;
          if ('scrollRestoration' in history) history.scrollRestoration = 'manual';
          // The site sets `scroll-behavior: smooth` (globals.css); jump instantly here so arrival is a
          // landing, not a long animated slide from the top.
          const de = document.documentElement;
          const prevSmooth = de.style.scrollBehavior;
          de.style.scrollBehavior = 'auto';
          let tries = 0;
          let timer = 0;
          const stop = () => {
            if (timer) { clearInterval(timer); timer = 0; }
            de.style.scrollBehavior = prevSmooth;
            window.removeEventListener('load', restore);
          };
          const restore = () => {
            // Stop as soon as we are there — never keep fighting a reader who scrolls on arrival.
            if (Math.abs(window.scrollY - top) < 2) { stop(); return; }
            window.scrollTo(0, top);
          };
          restore();
          requestAnimationFrame(restore);
          window.addEventListener('load', restore, { once: true });
          // Late layout (fonts, lazy media) can shift the target: re-apply briefly, then give up.
          timer = setInterval(() => { restore(); if (++tries > 8) stop(); }, 120);
        } catch { /* no sessionStorage (private mode) — nothing to restore */ }
      })();
    </script>
  </body>
</html>
<style is:global>
  /* Boot gate (see the inline script in <head>): the page is held, then fades in once the effects have
     had their ~800ms head start. Without JS the attribute is never set, so the page simply shows. */
  html[data-boot] body { opacity: 0; }
  body { transition: opacity 420ms var(--ease-out, ease); }
  @media (prefers-reduced-motion: reduce) { body { transition: none; } }
  /* Rounded window frame (style: React Bits Pro portfolio): a fixed 10px frame with rounded inner corners
     on all four sides. Implemented as one fixed element whose box-shadow paints the frame; it never takes
     pointer events and sits under dialogs (z 1000). Hidden on small screens where it would waste space. */
  .site-frame { position: fixed; inset: 10px; z-index: 900; pointer-events: none; border-radius: 34px; box-shadow: 0 0 0 100vmax var(--c-frame), inset 0 0 0 1px rgba(250, 250, 250, 0.08); }
  @media (max-width: 850px) { .site-frame { display: none; } }
  /* Ambient rays (Side Rays) sit behind the page content, which is raised above them. */
  .page-rays { position: fixed; inset: 0; z-index: 0; pointer-events: none; }
  body > main, body > footer { position: relative; z-index: 1; }
  .skip { position: absolute; left: 12px; top: -60px; z-index: 2000; padding: 10px 14px; border-radius: 8px; background: var(--c-fg); color: var(--c-bg); }
  .skip:focus { top: 12px; }
</style>
